#include <windows.h>

#ifndef AUTOENVPLUS_VERSION_MAJOR
#error AUTOENVPLUS_VERSION_MAJOR is required.
#endif
#ifndef AUTOENVPLUS_VERSION_MINOR
#error AUTOENVPLUS_VERSION_MINOR is required.
#endif
#ifndef AUTOENVPLUS_VERSION_PATCH
#error AUTOENVPLUS_VERSION_PATCH is required.
#endif
#ifndef AUTOENVPLUS_VERSION_REVISION
#error AUTOENVPLUS_VERSION_REVISION is required.
#endif

#define AUTOENVPLUS_STRINGIFY_INNER(value) #value
#define AUTOENVPLUS_STRINGIFY(value) AUTOENVPLUS_STRINGIFY_INNER(value)
#define AUTOENVPLUS_VERSION_TUPLE \
    AUTOENVPLUS_VERSION_MAJOR,AUTOENVPLUS_VERSION_MINOR,AUTOENVPLUS_VERSION_PATCH,AUTOENVPLUS_VERSION_REVISION
#define AUTOENVPLUS_VERSION_TEXT \
    AUTOENVPLUS_STRINGIFY(AUTOENVPLUS_VERSION_MAJOR) "." \
    AUTOENVPLUS_STRINGIFY(AUTOENVPLUS_VERSION_MINOR) "." \
    AUTOENVPLUS_STRINGIFY(AUTOENVPLUS_VERSION_PATCH) "." \
    AUTOENVPLUS_STRINGIFY(AUTOENVPLUS_VERSION_REVISION)

101 ICON "autoenvplus.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION AUTOENVPLUS_VERSION_TUPLE
 PRODUCTVERSION AUTOENVPLUS_VERSION_TUPLE
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "AutoEnvPlus contributors\0"
            VALUE "FileDescription", "AutoEnvPlus native command shim\0"
            VALUE "FileVersion", AUTOENVPLUS_VERSION_TEXT "\0"
            VALUE "InternalName", "autoenvplus-shim\0"
            VALUE "LegalCopyright", "Copyright (c) AutoEnvPlus contributors\0"
            VALUE "OriginalFilename", "autoenvplus-shim.exe\0"
            VALUE "ProductName", "AutoEnvPlus\0"
            VALUE "ProductVersion", AUTOENVPLUS_VERSION_TEXT "\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
