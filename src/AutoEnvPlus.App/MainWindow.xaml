<Window
    x:Class="AutoEnvPlus.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="AutoEnvPlus">

    <Grid
        x:Name="RootSurface"
        Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator
                Invoked="OnNavigationAcceleratorInvoked"
                Key="F"
                Modifiers="Control" />
            <KeyboardAccelerator
                Invoked="OnNavigationAcceleratorInvoked"
                Key="Number1"
                Modifiers="Control" />
            <KeyboardAccelerator
                Invoked="OnNavigationAcceleratorInvoked"
                Key="Number2"
                Modifiers="Control" />
            <KeyboardAccelerator
                Invoked="OnNavigationAcceleratorInvoked"
                Key="Number3"
                Modifiers="Control" />
            <KeyboardAccelerator
                Invoked="OnNavigationAcceleratorInvoked"
                Key="Number4"
                Modifiers="Control" />
            <KeyboardAccelerator
                Invoked="OnNavigationAcceleratorInvoked"
                Key="Number5"
                Modifiers="Control" />
            <KeyboardAccelerator
                Invoked="OnNavigationAcceleratorInvoked"
                Key="Number6"
                Modifiers="Control" />
            <KeyboardAccelerator
                Invoked="OnNavigationAcceleratorInvoked"
                Key="Number7"
                Modifiers="Control" />
            <KeyboardAccelerator
                Invoked="OnNavigationAcceleratorInvoked"
                Key="Number8"
                Modifiers="Control" />
            <KeyboardAccelerator
                Invoked="OnNavigationAcceleratorInvoked"
                Key="Number0"
                Modifiers="Control" />
        </Grid.KeyboardAccelerators>

        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition />
        </Grid.RowDefinitions>

        <Grid
            x:Name="AppTitleBar"
            Height="48"
            Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="TitleBarLeftInsetColumn" Width="0" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition />
                <ColumnDefinition x:Name="TitleBarRightInsetColumn" Width="0" />
            </Grid.ColumnDefinitions>

            <Border
                Grid.Column="1"
                Width="28"
                Height="28"
                Margin="12,0,0,0"
                VerticalAlignment="Center"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="6">
                <FontIcon
                    FontSize="15"
                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                    Glyph="&#xE756;" />
            </Border>
            <TextBlock
                Grid.Column="2"
                Margin="10,0,0,0"
                VerticalAlignment="Center"
                FontSize="15"
                FontWeight="SemiBold"
                Text="AutoEnvPlus" />
            <Border
                Grid.Column="3"
                Margin="10,0,0,0"
                VerticalAlignment="Center"
                Style="{StaticResource ShellVersionBadgeStyle}">
                <TextBlock
                    x:Name="VersionBadgeText"
                    FontSize="11"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </Border>
        </Grid>

        <NavigationView
            x:Name="RootNavigation"
            Grid.Row="1"
            AlwaysShowHeader="True"
            Background="Transparent"
            CompactModeThresholdWidth="720"
            CompactPaneLength="48"
            ExpandedModeThresholdWidth="1080"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="True"
            IsSettingsVisible="True"
            IsTitleBarAutoPaddingEnabled="False"
            OpenPaneLength="232"
            PaneDisplayMode="Auto"
            PaneTitle="AutoEnvPlus"
            SelectionChanged="OnNavigationSelectionChanged">

            <NavigationView.AutoSuggestBox>
                <AutoSuggestBox
                    x:Name="GlobalSearchBox"
                    MaxSuggestionListHeight="320"
                    QueryIcon="Find"
                    QuerySubmitted="OnGlobalSearchQuerySubmitted"
                    TextChanged="OnGlobalSearchTextChanged">
                    <AutoSuggestBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,6" Spacing="2">
                                <TextBlock FontWeight="SemiBold" Text="{Binding DisplayText}" />
                                <TextBlock
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{Binding DetailText}"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </DataTemplate>
                    </AutoSuggestBox.ItemTemplate>
                </AutoSuggestBox>
            </NavigationView.AutoSuggestBox>

            <NavigationView.Header>
                <Grid
                    x:Name="ShellPageHeader"
                    MinHeight="64"
                    Padding="0,4,24,12"
                    AutomationProperties.LiveSetting="Polite">
                    <StackPanel Spacing="2">
                        <TextBlock
                            x:Name="PageHeaderTitle"
                            FontSize="28"
                            FontWeight="SemiBold"
                            TextWrapping="Wrap" />
                        <TextBlock
                            x:Name="PageHeaderSubtitle"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </NavigationView.Header>

            <NavigationView.MenuItems>
                <NavigationViewItem
                    x:Name="NavDashboardItem"
                    Tag="dashboard">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE80F;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    x:Name="NavLanguagesItem"
                    Tag="languages">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE950;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    x:Name="NavMirrorsItem"
                    Tag="mirrors">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8F1;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    x:Name="NavProjectsItem"
                    Tag="projects">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8B7;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    x:Name="NavDownloadsItem"
                    Tag="downloads">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE896;" />
                    </NavigationViewItem.Icon>
                    <Grid>
                        <TextBlock x:Name="NavDownloadsText" VerticalAlignment="Center" />
                        <InfoBadge
                            x:Name="DownloadsTransferBadge"
                            HorizontalAlignment="Right"
                            Visibility="Collapsed" />
                    </Grid>
                </NavigationViewItem>
                <NavigationViewItem
                    x:Name="NavPathItem"
                    Tag="path">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8A5;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    x:Name="NavStorageItem"
                    Tag="storage">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xEDA2;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItemSeparator />
                <NavigationViewItem
                    x:Name="NavDoctorItem"
                    Tag="doctor">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE9D9;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    x:Name="NavActivityItem"
                    Tag="activity">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE823;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <Frame
                x:Name="ContentFrame"
                IsTabStop="False" />
        </NavigationView>
    </Grid>
</Window>
