<Page
    x:Class="AutoEnvPlus.App.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel
            x:Name="LayoutRoot"
            Padding="{StaticResource PagePadding}"
            Spacing="20">
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup>
                    <VisualState x:Name="CompactLayout">
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="0" />
                        </VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Target="SettingsHeaderActions.(Grid.Row)" Value="1" />
                            <Setter Target="SettingsHeaderActions.(Grid.Column)" Value="0" />
                            <Setter Target="SettingsHeaderActions.HorizontalAlignment" Value="Left" />
                            <Setter Target="SettingsHeaderActions.Margin" Value="0,12,0,0" />

                            <Setter Target="AppearancePrimaryColumn.Width" Value="*" />
                            <Setter Target="AppearanceBackdropColumn.Width" Value="0" />
                            <Setter Target="AppearanceDensityColumn.Width" Value="0" />
                            <Setter Target="AppearanceBackdropRow.Height" Value="Auto" />
                            <Setter Target="AppearanceDensityRow.Height" Value="Auto" />
                            <Setter Target="BackdropField.(Grid.Row)" Value="1" />
                            <Setter Target="BackdropField.(Grid.Column)" Value="0" />
                            <Setter Target="DensityField.(Grid.Row)" Value="2" />
                            <Setter Target="DensityField.(Grid.Column)" Value="0" />

                            <Setter Target="PowerShellActions.Orientation" Value="Vertical" />
                            <Setter Target="PowerShellActions.HorizontalAlignment" Value="Left" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="WideLayout">
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="760" />
                        </VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Target="SettingsHeaderActions.(Grid.Row)" Value="0" />
                            <Setter Target="SettingsHeaderActions.(Grid.Column)" Value="1" />
                            <Setter Target="SettingsHeaderActions.HorizontalAlignment" Value="Stretch" />
                            <Setter Target="SettingsHeaderActions.Margin" Value="0" />

                            <Setter Target="AppearancePrimaryColumn.Width" Value="*" />
                            <Setter Target="AppearanceBackdropColumn.Width" Value="*" />
                            <Setter Target="AppearanceDensityColumn.Width" Value="*" />
                            <Setter Target="AppearanceBackdropRow.Height" Value="0" />
                            <Setter Target="AppearanceDensityRow.Height" Value="0" />
                            <Setter Target="BackdropField.(Grid.Row)" Value="0" />
                            <Setter Target="BackdropField.(Grid.Column)" Value="1" />
                            <Setter Target="DensityField.(Grid.Row)" Value="0" />
                            <Setter Target="DensityField.(Grid.Column)" Value="2" />

                            <Setter Target="PowerShellActions.Orientation" Value="Horizontal" />
                            <Setter Target="PowerShellActions.HorizontalAlignment" Value="Stretch" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>

            <Grid ColumnSpacing="12" RowSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Spacing="4">
                    <TextBlock x:Name="PageTitleText" Style="{StaticResource TitleTextBlockStyle}" />
                    <TextBlock
                        x:Name="PageSubtitleText"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel
                    x:Name="SettingsHeaderActions"
                    Grid.Column="1"
                    VerticalAlignment="Bottom"
                    Orientation="Horizontal"
                    Spacing="8">
                    <ProgressRing
                        x:Name="SettingsProgress"
                        Width="20"
                        Height="20"
                        IsActive="False" />
                    <Button
                        x:Name="SaveSettingsButton"
                        Click="OnSaveSettingsClicked"
                        Style="{StaticResource AccentButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <SymbolIcon Symbol="Save" />
                            <TextBlock x:Name="SaveSettingsButtonText" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <InfoBar
                x:Name="SettingsInfo"
                AutomationProperties.LiveSetting="Polite"
                IsClosable="False"
                IsOpen="False" />

            <Border
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,1"
                Padding="0,18">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border
                        Width="40"
                        Height="40"
                        Background="{ThemeResource AccentFillColorSecondaryBrush}"
                        CornerRadius="8">
                        <FontIcon
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="18"
                            Glyph="&#xE777;" />
                    </Border>

                    <StackPanel Grid.Column="1" Spacing="5">
                        <TextBlock x:Name="LanguageSectionTitleText" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBlock
                            x:Name="LanguageSectionSubtitleText"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap" />
                        <StackPanel Margin="0,10,0,0" Spacing="4">
                            <TextBlock x:Name="LanguageFieldLabelText" />
                            <ComboBox
                                x:Name="LanguagePicker"
                                HorizontalAlignment="Stretch"
                                DisplayMemberPath="Label" />
                        </StackPanel>
                        <TextBlock
                            x:Name="LanguageRestartHint"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,1"
                Padding="0,18">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border
                        Width="40"
                        Height="40"
                        Background="{ThemeResource AccentFillColorSecondaryBrush}"
                        CornerRadius="8">
                        <FontIcon
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="18"
                            Glyph="&#xE790;" />
                    </Border>

                    <StackPanel Grid.Column="1" Spacing="5">
                        <TextBlock
                            x:Name="AppearanceSectionTitleText"
                            Style="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBlock
                            x:Name="AppearanceSectionSubtitleText"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock
                            x:Name="EffectiveBackdropText"
                            AutomationProperties.LiveSetting="Polite"
                            FontWeight="SemiBold"
                            IsTextSelectionEnabled="True" />
                        <TextBlock
                            x:Name="BackdropDescriptionText"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            IsTextSelectionEnabled="True"
                            TextWrapping="Wrap" />
                        <Grid Margin="0,10,0,0" ColumnSpacing="12" RowSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="AppearancePrimaryColumn" Width="*" />
                                <ColumnDefinition x:Name="AppearanceBackdropColumn" Width="*" />
                                <ColumnDefinition x:Name="AppearanceDensityColumn" Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition x:Name="AppearanceBackdropRow" Height="0" />
                                <RowDefinition x:Name="AppearanceDensityRow" Height="0" />
                            </Grid.RowDefinitions>
                            <StackPanel x:Name="ThemeField" Spacing="4">
                                <TextBlock x:Name="ThemeFieldLabelText" />
                                <ComboBox
                                    x:Name="ThemePicker"
                                    HorizontalAlignment="Stretch"
                                    DisplayMemberPath="Label" />
                            </StackPanel>
                            <StackPanel
                                x:Name="BackdropField"
                                Grid.Column="1"
                                Spacing="4">
                                <TextBlock x:Name="BackdropFieldLabelText" />
                                <ComboBox
                                    x:Name="BackdropPicker"
                                    HorizontalAlignment="Stretch"
                                    DisplayMemberPath="Label" />
                            </StackPanel>
                            <StackPanel
                                x:Name="DensityField"
                                Grid.Column="2"
                                Spacing="4">
                                <TextBlock x:Name="DensityFieldLabelText" />
                                <ComboBox
                                    x:Name="DensityPicker"
                                    HorizontalAlignment="Stretch"
                                    DisplayMemberPath="Label" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>

            <Expander x:Name="StartupSnapshotExpander" IsExpanded="True">
                <StackPanel Padding="0,12,0,6" Spacing="12">
                    <StackPanel Spacing="4">
                        <TextBlock x:Name="StartupDestinationLabelText" />
                        <ComboBox
                            x:Name="StartupDestinationPicker"
                            HorizontalAlignment="Stretch"
                            DisplayMemberPath="Label" />
                    </StackPanel>
                    <InfoBar
                        x:Name="StartupScanPolicyInfoBar"
                        IsClosable="False"
                        IsOpen="True"
                        Severity="Informational" />
                </StackPanel>
            </Expander>

            <Expander x:Name="LanguageCatalogExpander">
                <StackPanel Padding="0,12,0,6" Spacing="12">
                    <StackPanel Spacing="4">
                        <TextBlock x:Name="LanguageVisibilityLabelText" />
                        <ComboBox
                            x:Name="LanguageVisibilityPicker"
                            HorizontalAlignment="Stretch"
                            DisplayMemberPath="Label" />
                    </StackPanel>
                    <ToggleSwitch x:Name="ExperimentalToolsToggle" />
                    <TextBlock
                        x:Name="ExperimentalToolsHintText"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Expander>

            <Expander x:Name="DownloadDefaultsExpander">
                <StackPanel Padding="0,12,0,6" Spacing="12">
                    <StackPanel Spacing="4">
                        <TextBlock x:Name="DefaultConnectionsLabelText" />
                        <ComboBox
                            x:Name="DefaultConnectionsPicker"
                            HorizontalAlignment="Stretch"
                            DisplayMemberPath="Label" />
                    </StackPanel>
                    <StackPanel Spacing="4">
                        <TextBlock x:Name="MaxDownloadGbLabelText" />
                        <NumberBox
                            x:Name="MaxDownloadGbNumber"
                            Minimum="1"
                            Maximum="1024"
                            SpinButtonPlacementMode="Compact" />
                    </StackPanel>
                </StackPanel>
            </Expander>

            <Expander x:Name="NetworkProxyExpander">
                <StackPanel Padding="0,12,0,6" Spacing="12">
                    <TextBlock
                        x:Name="NetworkProxyIntroText"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap" />
                    <StackPanel Spacing="4">
                        <TextBlock x:Name="HttpProxyLabelText" />
                        <TextBox
                            x:Name="HttpProxyTextBox"
                            PlaceholderText="http://proxy.example:8080" />
                        <TextBlock
                            x:Name="HttpProxyHintText"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Spacing="4">
                        <TextBlock x:Name="HttpsProxyLabelText" />
                        <TextBox
                            x:Name="HttpsProxyTextBox"
                            PlaceholderText="http://proxy.example:8080" />
                        <TextBlock
                            x:Name="HttpsProxyHintText"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Spacing="4">
                        <TextBlock x:Name="NoProxyLabelText" />
                        <TextBox
                            x:Name="NoProxyTextBox"
                            AcceptsReturn="True"
                            MinHeight="72"
                            PlaceholderText="localhost, 127.0.0.1, *.internal"
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <Button
                        x:Name="SaveProxyButton"
                        Click="OnSaveProxyClicked"
                        HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <SymbolIcon Symbol="Globe" />
                            <TextBlock x:Name="SaveProxyButtonText" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Expander>

            <Expander x:Name="LoggingPolicyExpander">
                <StackPanel Padding="0,12,0,6" Spacing="12">
                    <InfoBar
                        x:Name="SecurityContractInfoBar"
                        IsClosable="False"
                        IsOpen="True"
                        Severity="Informational" />
                    <StackPanel Spacing="4">
                        <TextBlock x:Name="LogRetentionLabelText" />
                        <NumberBox
                            x:Name="LogRetentionNumber"
                            Minimum="1"
                            Maximum="365"
                            SpinButtonPlacementMode="Compact" />
                    </StackPanel>
                    <TextBlock
                        x:Name="LogRetentionHintText"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Expander>

            <Border
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,1"
                Padding="0,18">
                <Grid RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Spacing="6">
                        <TextBlock
                            x:Name="ManagedRootSectionTitleText"
                            Style="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBlock
                            x:Name="ManagedRootSectionSubtitleText"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap" />
                        <TextBlock
                            x:Name="ManagedRootText"
                            FontWeight="SemiBold"
                            IsTextSelectionEnabled="True"
                            TextWrapping="WrapWholeWords" />
                        <TextBlock
                            x:Name="ManagedRootDescriptionText"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            IsTextSelectionEnabled="True"
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel
                        Grid.Row="1"
                        Orientation="Horizontal"
                        Spacing="8">
                        <Button
                            x:Name="ChooseManagedRootButton"
                            Click="OnChooseManagedRootClicked">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <SymbolIcon Symbol="OpenFile" />
                                <TextBlock x:Name="ChooseManagedRootButtonText" />
                            </StackPanel>
                        </Button>
                        <Button
                            x:Name="ResetManagedRootButton"
                            Click="OnResetManagedRootClicked">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <SymbolIcon Symbol="Undo" />
                                <TextBlock x:Name="ResetManagedRootButtonText" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <InfoBar
                        x:Name="ManagedRootInfo"
                        Grid.Row="2"
                        AutomationProperties.LiveSetting="Polite"
                        IsClosable="False"
                        IsOpen="False" />
                </Grid>
            </Border>

            <Border
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,1"
                Padding="0,18">
                <Grid RowSpacing="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Spacing="6">
                        <TextBlock
                            x:Name="PowerShellSectionTitleText"
                            Style="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBlock
                            x:Name="PowerShellSectionSubtitleText"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap" />
                        <TextBlock
                            x:Name="ProfilePathText"
                            IsTextSelectionEnabled="True"
                            TextWrapping="WrapWholeWords" />
                    </StackPanel>

                    <StackPanel
                        x:Name="PowerShellActions"
                        Grid.Row="1"
                        Orientation="Horizontal"
                        Spacing="8">
                        <Button
                            x:Name="PreviewPowerShellButton"
                            Click="OnPreviewPowerShellClicked">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <SymbolIcon Symbol="View" />
                                <TextBlock x:Name="PreviewPowerShellButtonText" />
                            </StackPanel>
                        </Button>
                        <Button
                            x:Name="InstallPowerShellButton"
                            Click="OnInstallPowerShellClicked"
                            Style="{StaticResource AccentButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <SymbolIcon Symbol="Accept" />
                                <TextBlock x:Name="InstallPowerShellButtonText" />
                            </StackPanel>
                        </Button>
                        <Button
                            x:Name="RollbackPowerShellButton"
                            Click="OnRollbackPowerShellClicked"
                            IsEnabled="False">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <SymbolIcon Symbol="Undo" />
                                <TextBlock x:Name="RollbackPowerShellButtonText" />
                            </StackPanel>
                        </Button>
                        <ProgressRing
                            x:Name="PowerShellProgress"
                            Width="20"
                            Height="20"
                            IsActive="False" />
                    </StackPanel>
                </Grid>
            </Border>

            <InfoBar
                x:Name="PowerShellInfo"
                AutomationProperties.LiveSetting="Polite"
                IsClosable="False"
                IsOpen="False" />

            <Pivot x:Name="PowerShellPreviewPivot" Visibility="Collapsed">
                <PivotItem x:Name="PowerShellSummaryPivotItem">
                    <TextBox
                        x:Name="PowerShellSummaryText"
                        MinHeight="150"
                        MaxHeight="280"
                        AcceptsReturn="True"
                        FontFamily="Consolas"
                        IsReadOnly="True"
                        TextWrapping="Wrap" />
                </PivotItem>
                <PivotItem Header="Profile">
                    <TextBox
                        x:Name="PowerShellProfilePreviewText"
                        MinHeight="220"
                        MaxHeight="420"
                        AcceptsReturn="True"
                        FontFamily="Consolas"
                        IsReadOnly="True"
                        ScrollViewer.HorizontalScrollBarVisibility="Auto"
                        ScrollViewer.VerticalScrollBarVisibility="Auto"
                        TextWrapping="NoWrap"
                        />
                </PivotItem>
                <PivotItem x:Name="PowerShellModulePivotItem">
                    <TextBox
                        x:Name="PowerShellModulePreviewText"
                        MinHeight="220"
                        MaxHeight="420"
                        AcceptsReturn="True"
                        FontFamily="Consolas"
                        IsReadOnly="True"
                        ScrollViewer.HorizontalScrollBarVisibility="Auto"
                        ScrollViewer.VerticalScrollBarVisibility="Auto"
                        TextWrapping="NoWrap"
                        />
                </PivotItem>
            </Pivot>

            <Border
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,1"
                Padding="0,18">
                <StackPanel Spacing="10">
                    <TextBlock x:Name="AboutSectionTitleText" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <StackPanel Spacing="2">
                        <TextBlock
                            x:Name="AboutVersionText"
                            FontWeight="SemiBold"
                            IsTextSelectionEnabled="True" />
                        <TextBlock
                            x:Name="AboutTaglineText"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            IsTextSelectionEnabled="True"
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <HyperlinkButton
                            x:Name="GitHubRepoLink"
                            NavigateUri="https://github.com/yeyouyby/autoenvplus" />
                        <HyperlinkButton
                            x:Name="ReleaseNotesLink"
                            NavigateUri="https://github.com/yeyouyby/autoenvplus/releases" />
                        <HyperlinkButton
                            x:Name="IssueFeedbackLink"
                            NavigateUri="https://github.com/yeyouyby/autoenvplus/issues" />
                    </StackPanel>
                    <TextBlock
                        x:Name="AboutManagedRootText"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        IsTextSelectionEnabled="True"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
