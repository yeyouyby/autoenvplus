<Page
    x:Class="AutoEnvPlus.App.Pages.LanguagesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <ScrollViewer x:Name="ListSurface">
            <StackPanel
                x:Name="LayoutRoot"
                Padding="{StaticResource PagePadding}"
                Spacing="18">
                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroup>
                        <VisualState x:Name="CompactLayout">
                            <VisualState.StateTriggers>
                                <AdaptiveTrigger MinWindowWidth="0" />
                            </VisualState.StateTriggers>
                            <VisualState.Setters>
                                <Setter Target="HeaderActions.(Grid.Row)" Value="1" />
                                <Setter Target="HeaderActions.(Grid.Column)" Value="0" />
                                <Setter Target="HeaderActions.Margin" Value="0,12,0,0" />
                                <Setter Target="FilterPanel.Orientation" Value="Vertical" />
                                <Setter Target="SearchBox.Width" Value="NaN" />
                                <Setter Target="FilterCombo.Width" Value="NaN" />
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState x:Name="WideLayout">
                            <VisualState.StateTriggers>
                                <AdaptiveTrigger MinWindowWidth="760" />
                            </VisualState.StateTriggers>
                            <VisualState.Setters>
                                <Setter Target="HeaderActions.(Grid.Row)" Value="0" />
                                <Setter Target="HeaderActions.(Grid.Column)" Value="1" />
                                <Setter Target="HeaderActions.Margin" Value="12,0,0,0" />
                                <Setter Target="FilterPanel.Orientation" Value="Horizontal" />
                                <Setter Target="SearchBox.Width" Value="320" />
                                <Setter Target="FilterCombo.Width" Value="190" />
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateManager.VisualStateGroups>

                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Spacing="4">
                        <TextBlock x:Name="PageTitleText" Style="{StaticResource TitleTextBlockStyle}" />
                        <TextBlock
                            x:Name="PageSubtitleText"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel
                        x:Name="HeaderActions"
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="8">
                        <ProgressRing
                            x:Name="RefreshProgress"
                            Width="20"
                            Height="20"
                            AutomationProperties.LiveSetting="Polite"
                            IsActive="False" />
                        <Button
                            x:Name="RefreshButton"
                            Click="OnRefreshClicked">
                            <SymbolIcon Symbol="Refresh" />
                        </Button>
                        <Button
                            x:Name="ImportPackButton"
                            Click="OnImportLanguagePackClicked">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <SymbolIcon Symbol="OpenFile" />
                                <TextBlock x:Name="ImportPackButtonText" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <InfoBar
                    x:Name="StatusInfo"
                    AutomationProperties.LiveSetting="Polite"
                    IsClosable="False"
                    IsOpen="True"
                    Severity="Informational" />

                <InfoBar
                    x:Name="CatalogNoteInfo"
                    IsClosable="False"
                    IsOpen="True"
                    Severity="Informational" />

                <Border
                    Padding="16"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource CardCornerRadius}">
                    <StackPanel x:Name="FilterPanel" Spacing="10">
                        <AutoSuggestBox
                            x:Name="SearchBox"
                            QueryIcon="Find"
                            TextChanged="OnSearchTextChanged" />
                        <ComboBox
                            x:Name="FilterCombo"
                            DisplayMemberPath="Label"
                            SelectionChanged="OnFilterChanged" />
                        <ToggleSwitch
                            x:Name="ShowAllToggle"
                            Toggled="OnShowAllToggled" />
                    </StackPanel>
                </Border>

                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="2">
                        <TextBlock x:Name="LanguageMappingTitleText" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBlock
                            x:Name="LanguageSummaryText"
                            AutomationProperties.LiveSetting="Polite"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <Button
                        x:Name="ResetVisibilityButton"
                        Grid.Column="1"
                        Click="OnResetVisibilityClicked">
                        <FontIcon Glyph="&#xE777;" />
                    </Button>
                </Grid>

                <Grid MinHeight="120">
                    <ListView
                        x:Name="LanguageList"
                        IsItemClickEnabled="False"
                        SelectionMode="None">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,0,0,8" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border
                                    Padding="16"
                                    AutomationProperties.Name="{Binding AutomationName}"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource CardCornerRadius}">
                                    <Grid ColumnSpacing="14" RowSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="44" />
                                            <ColumnDefinition />
                                            <ColumnDefinition x:Name="LanguageActionsColumn" Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition />
                                            <RowDefinition x:Name="LanguageActionsRow" Height="0" />
                                        </Grid.RowDefinitions>
                                        <VisualStateManager.VisualStateGroups>
                                            <VisualStateGroup>
                                                <VisualState x:Name="CompactLanguageItem">
                                                    <VisualState.StateTriggers>
                                                        <AdaptiveTrigger MinWindowWidth="0" />
                                                    </VisualState.StateTriggers>
                                                    <VisualState.Setters>
                                                        <Setter Target="LanguageActionsColumn.Width" Value="0" />
                                                        <Setter Target="LanguageActionsRow.Height" Value="Auto" />
                                                        <Setter Target="LanguageActions.(Grid.Row)" Value="1" />
                                                        <Setter Target="LanguageActions.(Grid.Column)" Value="1" />
                                                        <Setter Target="LanguageActions.Margin" Value="0,4,0,0" />
                                                        <Setter Target="LanguageActions.HorizontalAlignment" Value="Left" />
                                                    </VisualState.Setters>
                                                </VisualState>
                                                <VisualState x:Name="WideLanguageItem">
                                                    <VisualState.StateTriggers>
                                                        <AdaptiveTrigger MinWindowWidth="700" />
                                                    </VisualState.StateTriggers>
                                                    <VisualState.Setters>
                                                        <Setter Target="LanguageActionsColumn.Width" Value="Auto" />
                                                        <Setter Target="LanguageActionsRow.Height" Value="0" />
                                                        <Setter Target="LanguageActions.(Grid.Row)" Value="0" />
                                                        <Setter Target="LanguageActions.(Grid.Column)" Value="2" />
                                                        <Setter Target="LanguageActions.Margin" Value="0" />
                                                        <Setter Target="LanguageActions.HorizontalAlignment" Value="Stretch" />
                                                    </VisualState.Setters>
                                                </VisualState>
                                            </VisualStateGroup>
                                        </VisualStateManager.VisualStateGroups>
                                        <Border
                                            Width="40"
                                            Height="40"
                                            VerticalAlignment="Top"
                                            Background="{ThemeResource AccentFillColorSecondaryBrush}"
                                            CornerRadius="6">
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                FontSize="16"
                                                FontWeight="SemiBold"
                                                Text="{Binding Monogram}" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Spacing="5">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock FontSize="17" FontWeight="SemiBold" Text="{Binding DisplayName}" />
                                                <Border
                                                    Padding="6,2"
                                                    Background="{ThemeResource AccentFillColorTertiaryBrush}"
                                                    CornerRadius="4"
                                                    Visibility="{Binding DetectedVisibility}">
                                                    <TextBlock FontSize="12" Loaded="OnDetectedBadgeLoaded" />
                                                </Border>
                                                <Border
                                                    Padding="6,2"
                                                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                                    CornerRadius="4"
                                                    Visibility="{Binding DefaultVisibility}">
                                                    <TextBlock FontSize="12" Loaded="OnDefaultBadgeLoaded" />
                                                </Border>
                                                <Border
                                                    Padding="6,2"
                                                    Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
                                                    CornerRadius="4"
                                                    Visibility="{Binding HiddenVisibility}">
                                                    <TextBlock FontSize="12" Loaded="OnHiddenBadgeLoaded" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Text="{Binding ToolSummary}"
                                                TextWrapping="Wrap" />
                                            <TextBlock
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Text="{Binding IdentitySummary}"
                                                TextWrapping="Wrap" />
                                        </StackPanel>
                                        <StackPanel
                                            x:Name="LanguageActions"
                                            Grid.Column="2"
                                            VerticalAlignment="Center"
                                            Orientation="Horizontal"
                                            Spacing="6">
                                            <Button
                                                AutomationProperties.Name="{Binding VisibilityActionText}"
                                                Click="OnToggleLanguageVisibilityClicked"
                                                Tag="{Binding}"
                                                ToolTipService.ToolTip="{Binding VisibilityActionText}">
                                                <FontIcon Glyph="{Binding VisibilityGlyph}" />
                                            </Button>
                                            <Button
                                                AutomationProperties.Name="{Binding OpenActionAutomationName}"
                                                Click="OnOpenLanguageClicked"
                                                Loaded="OnOpenLanguageButtonLoaded"
                                                Tag="{Binding}">
                                                <SymbolIcon Symbol="Forward" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <StackPanel
                        x:Name="EmptyLanguageState"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="4"
                        Visibility="Collapsed">
                        <TextBlock
                            x:Name="EmptyLanguageTitleText"
                            HorizontalAlignment="Center"
                            FontWeight="SemiBold" />
                        <TextBlock
                            x:Name="EmptyLanguageHintText"
                            HorizontalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>

                <Expander x:Name="LanguagePackExpander" IsExpanded="False">
                    <Expander.Header>
                        <StackPanel Spacing="2">
                            <TextBlock x:Name="LanguagePackTitleText" Style="{StaticResource SubtitleTextBlockStyle}" />
                            <TextBlock
                                x:Name="LanguagePackSummaryText"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Expander.Header>
                    <StackPanel Padding="0,12,0,0" Spacing="10">
                        <InfoBar
                            x:Name="LanguagePackSchemaInfo"
                            IsClosable="False"
                            IsOpen="True"
                            Severity="Informational" />
                        <ListView
                            x:Name="LanguagePackList"
                            IsItemClickEnabled="False"
                            SelectionMode="None">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0,0,0,8" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Border
                                        Padding="14"
                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="{StaticResource CardCornerRadius}">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Spacing="4">
                                                <TextBlock FontWeight="SemiBold" Text="{Binding DisplayName}" />
                                                <TextBlock
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Text="{Binding Detail}"
                                                    TextWrapping="Wrap" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                                <Button
                                                    AutomationProperties.Name="{Binding ToggleActionAutomationName}"
                                                    Click="OnToggleLanguagePackClicked"
                                                    Content="{Binding ToggleText}"
                                                    Tag="{Binding}" />
                                                <Button
                                                    AutomationProperties.Name="{Binding DeleteActionAutomationName}"
                                                    Click="OnDeleteLanguagePackClicked"
                                                    Loaded="OnDeletePackButtonLoaded"
                                                    Tag="{Binding}">
                                                    <SymbolIcon Symbol="Delete" />
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <TextBlock
                            x:Name="EmptyPackText"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Expander>
            </StackPanel>
        </ScrollViewer>

        <ContentControl
            x:Name="DetailSurface"
            Visibility="Collapsed" />
    </Grid>
</Page>
