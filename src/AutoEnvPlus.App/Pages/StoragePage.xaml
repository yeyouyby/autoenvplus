<Page
    x:Class="AutoEnvPlus.App.Pages.StoragePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid
        x:Name="LayoutRoot"
        Padding="{StaticResource PagePadding}"
        RowSpacing="16">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="CompactLayout">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="StorageHeaderActions.(Grid.Row)" Value="1" />
                        <Setter Target="StorageHeaderActions.(Grid.Column)" Value="0" />
                        <Setter Target="StorageHeaderActions.HorizontalAlignment" Value="Left" />
                        <Setter Target="StorageHeaderActions.Margin" Value="0,12,0,0" />
                        <Setter Target="StorageHeaderActions.Orientation" Value="Vertical" />

                        <Setter Target="CleanupTitleColumn.Width" Value="*" />
                        <Setter Target="CleanupPickerColumn.Width" Value="0" />
                        <Setter Target="CleanupActionsColumn.Width" Value="0" />
                        <Setter Target="CleanupPickerRow.Height" Value="Auto" />
                        <Setter Target="CleanupActionsRow.Height" Value="Auto" />
                        <Setter Target="CleanupItemPicker.(Grid.Row)" Value="1" />
                        <Setter Target="CleanupItemPicker.(Grid.Column)" Value="0" />
                        <Setter Target="CleanupActions.(Grid.Row)" Value="2" />
                        <Setter Target="CleanupActions.(Grid.Column)" Value="0" />
                        <Setter Target="CleanupActions.Orientation" Value="Vertical" />

                        <Setter Target="CacheHeader.Visibility" Value="Collapsed" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="WideLayout">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="860" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="StorageHeaderActions.(Grid.Row)" Value="0" />
                        <Setter Target="StorageHeaderActions.(Grid.Column)" Value="1" />
                        <Setter Target="StorageHeaderActions.HorizontalAlignment" Value="Stretch" />
                        <Setter Target="StorageHeaderActions.Margin" Value="0" />
                        <Setter Target="StorageHeaderActions.Orientation" Value="Horizontal" />

                        <Setter Target="CleanupTitleColumn.Width" Value="Auto" />
                        <Setter Target="CleanupPickerColumn.Width" Value="*" />
                        <Setter Target="CleanupActionsColumn.Width" Value="Auto" />
                        <Setter Target="CleanupPickerRow.Height" Value="0" />
                        <Setter Target="CleanupActionsRow.Height" Value="0" />
                        <Setter Target="CleanupItemPicker.(Grid.Row)" Value="0" />
                        <Setter Target="CleanupItemPicker.(Grid.Column)" Value="1" />
                        <Setter Target="CleanupActions.(Grid.Row)" Value="0" />
                        <Setter Target="CleanupActions.(Grid.Column)" Value="2" />
                        <Setter Target="CleanupActions.Orientation" Value="Horizontal" />

                        <Setter Target="CacheHeader.Visibility" Value="Visible" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" ColumnSpacing="16" RowSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Spacing="4">
                <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="缓存与存储" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="识别 pip、npm、pnpm、Yarn、NuGet、Maven、Gradle、vcpkg 和 Conan 的真实存储位置与配置来源。"
                    TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel
                x:Name="StorageHeaderActions"
                Grid.Column="1"
                VerticalAlignment="Bottom"
                Orientation="Horizontal"
                Spacing="8">
                <ProgressRing
                    x:Name="StorageOperationProgress"
                    Width="20"
                    Height="20"
                    AutomationProperties.Name="存储操作进度"
                    IsActive="False" />
                <Button
                    x:Name="CancelStorageOperationButton"
                    Click="OnCancelStorageOperationClicked"
                    IsEnabled="False"
                    ToolTipService.ToolTip="取消当前存储操作">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <SymbolIcon Symbol="Cancel" />
                        <TextBlock Text="取消当前操作" />
                    </StackPanel>
                </Button>
                <Button
                    x:Name="RollbackButton"
                    Click="OnRollbackClicked"
                    IsEnabled="False"
                    ToolTipService.ToolTip="恢复最近一次迁移前的工具配置">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <SymbolIcon Symbol="Undo" />
                        <TextBlock Text="回滚最近配置" />
                    </StackPanel>
                </Button>
                <Button
                    x:Name="MeasureButton"
                    Click="OnMeasureClicked"
                    Content="计算全部大小" />
            </StackPanel>
        </Grid>

        <InfoBar
            x:Name="StorageInfo"
            Grid.Row="1"
            AutomationProperties.LiveSetting="Polite"
            IsClosable="False"
            IsOpen="True"
            Message="迁移保留原目录；安全清理先移入同卷隔离区。Gradle 与 Conan 根目录包含配置，不提供整目录清理。"
            Severity="Informational"
            Title="已读取当前配置" />

        <Grid
            Grid.Row="2"
            Padding="12,8"
            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
            ColumnSpacing="8"
            RowSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="CleanupTitleColumn" Width="Auto" />
                <ColumnDefinition x:Name="CleanupPickerColumn" />
                <ColumnDefinition x:Name="CleanupActionsColumn" Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition x:Name="CleanupPickerRow" Height="0" />
                <RowDefinition x:Name="CleanupActionsRow" Height="0" />
            </Grid.RowDefinitions>
            <StackPanel VerticalAlignment="Center" Orientation="Horizontal" Spacing="8">
                <TextBlock FontWeight="SemiBold" Text="安全隔离区" />
                <TextBlock
                    x:Name="CleanupItemCountText"
                    AutomationProperties.LiveSetting="Polite"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="无待处理项" />
            </StackPanel>
            <ComboBox
                x:Name="CleanupItemPicker"
                Grid.Column="1"
                MinWidth="0"
                AutomationProperties.Name="选择安全隔离区项目"
                HorizontalAlignment="Stretch"
                DisplayMemberPath="DisplayText"
                PlaceholderText="没有可恢复或清空的缓存"
                SelectionChanged="OnCleanupItemSelectionChanged" />
            <StackPanel
                x:Name="CleanupActions"
                Grid.Column="2"
                Orientation="Horizontal"
                Spacing="8">
                <Button
                    x:Name="RestoreCleanupButton"
                    Click="OnRestoreCleanupClicked"
                    IsEnabled="False"
                    ToolTipService.ToolTip="将隔离内容移回原缓存目录">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <SymbolIcon Symbol="Undo" />
                        <TextBlock Text="恢复" />
                    </StackPanel>
                </Button>
                <Button
                    x:Name="PurgeCleanupButton"
                    Click="OnPurgeCleanupClicked"
                    IsEnabled="False"
                    ToolTipService.ToolTip="永久删除已复检的隔离内容">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <SymbolIcon Symbol="Delete" />
                        <TextBlock Text="永久清空" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <Grid
            x:Name="CacheHeader"
            Grid.Row="3"
            Padding="12,8"
            ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="170" />
                <ColumnDefinition />
                <ColumnDefinition Width="160" />
                <ColumnDefinition Width="110" />
                <ColumnDefinition Width="210" />
            </Grid.ColumnDefinitions>
            <TextBlock FontWeight="SemiBold" Text="工具" />
            <TextBlock Grid.Column="1" FontWeight="SemiBold" Text="目录" />
            <TextBlock Grid.Column="2" FontWeight="SemiBold" Text="来源" />
            <TextBlock Grid.Column="3" FontWeight="SemiBold" Text="大小" />
            <TextBlock Grid.Column="4" FontWeight="SemiBold" Text="操作" />
        </Grid>

        <ListView
            x:Name="CacheList"
            Grid.Row="4"
            SelectionMode="None">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="12,8" ColumnSpacing="12" RowSpacing="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="CacheNameColumn" Width="170" />
                            <ColumnDefinition x:Name="CacheDirectoryColumn" />
                            <ColumnDefinition x:Name="CacheSourceColumn" Width="160" />
                            <ColumnDefinition x:Name="CacheSizeColumn" Width="110" />
                            <ColumnDefinition x:Name="CacheActionsColumn" Width="210" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition x:Name="CacheDirectoryRow" Height="0" />
                            <RowDefinition x:Name="CacheSourceRow" Height="0" />
                            <RowDefinition x:Name="CacheSizeRow" Height="0" />
                            <RowDefinition x:Name="CacheActionsRow" Height="0" />
                        </Grid.RowDefinitions>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup>
                                <VisualState x:Name="CompactCacheItem">
                                    <VisualState.StateTriggers>
                                        <AdaptiveTrigger MinWindowWidth="0" />
                                    </VisualState.StateTriggers>
                                    <VisualState.Setters>
                                        <Setter Target="CacheNameColumn.Width" Value="*" />
                                        <Setter Target="CacheDirectoryColumn.Width" Value="0" />
                                        <Setter Target="CacheSourceColumn.Width" Value="0" />
                                        <Setter Target="CacheSizeColumn.Width" Value="0" />
                                        <Setter Target="CacheActionsColumn.Width" Value="0" />
                                        <Setter Target="CacheDirectoryRow.Height" Value="Auto" />
                                        <Setter Target="CacheSourceRow.Height" Value="Auto" />
                                        <Setter Target="CacheSizeRow.Height" Value="Auto" />
                                        <Setter Target="CacheActionsRow.Height" Value="Auto" />
                                        <Setter Target="CacheNameText.(Grid.ColumnSpan)" Value="5" />
                                        <Setter Target="CacheDirectoryText.(Grid.Row)" Value="1" />
                                        <Setter Target="CacheDirectoryText.(Grid.Column)" Value="0" />
                                        <Setter Target="CacheDirectoryText.(Grid.ColumnSpan)" Value="5" />
                                        <Setter Target="CacheDirectoryText.TextTrimming" Value="None" />
                                        <Setter Target="CacheDirectoryText.TextWrapping" Value="WrapWholeWords" />
                                        <Setter Target="CacheSourceText.(Grid.Row)" Value="2" />
                                        <Setter Target="CacheSourceText.(Grid.Column)" Value="0" />
                                        <Setter Target="CacheSourceText.(Grid.ColumnSpan)" Value="5" />
                                        <Setter Target="CacheSourceText.TextTrimming" Value="None" />
                                        <Setter Target="CacheSourceText.TextWrapping" Value="Wrap" />
                                        <Setter Target="CacheSizeText.(Grid.Row)" Value="3" />
                                        <Setter Target="CacheSizeText.(Grid.Column)" Value="0" />
                                        <Setter Target="CacheItemActions.(Grid.Row)" Value="4" />
                                        <Setter Target="CacheItemActions.(Grid.Column)" Value="0" />
                                        <Setter Target="CacheItemActions.(Grid.ColumnSpan)" Value="5" />
                                        <Setter Target="CacheItemActions.Orientation" Value="Vertical" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="WideCacheItem">
                                    <VisualState.StateTriggers>
                                        <AdaptiveTrigger MinWindowWidth="860" />
                                    </VisualState.StateTriggers>
                                    <VisualState.Setters>
                                        <Setter Target="CacheNameColumn.Width" Value="170" />
                                        <Setter Target="CacheDirectoryColumn.Width" Value="*" />
                                        <Setter Target="CacheSourceColumn.Width" Value="160" />
                                        <Setter Target="CacheSizeColumn.Width" Value="110" />
                                        <Setter Target="CacheActionsColumn.Width" Value="210" />
                                        <Setter Target="CacheDirectoryRow.Height" Value="0" />
                                        <Setter Target="CacheSourceRow.Height" Value="0" />
                                        <Setter Target="CacheSizeRow.Height" Value="0" />
                                        <Setter Target="CacheActionsRow.Height" Value="0" />
                                        <Setter Target="CacheNameText.(Grid.ColumnSpan)" Value="1" />
                                        <Setter Target="CacheDirectoryText.(Grid.Row)" Value="0" />
                                        <Setter Target="CacheDirectoryText.(Grid.Column)" Value="1" />
                                        <Setter Target="CacheDirectoryText.(Grid.ColumnSpan)" Value="1" />
                                        <Setter Target="CacheDirectoryText.TextTrimming" Value="CharacterEllipsis" />
                                        <Setter Target="CacheDirectoryText.TextWrapping" Value="NoWrap" />
                                        <Setter Target="CacheSourceText.(Grid.Row)" Value="0" />
                                        <Setter Target="CacheSourceText.(Grid.Column)" Value="2" />
                                        <Setter Target="CacheSourceText.(Grid.ColumnSpan)" Value="1" />
                                        <Setter Target="CacheSourceText.TextTrimming" Value="CharacterEllipsis" />
                                        <Setter Target="CacheSourceText.TextWrapping" Value="NoWrap" />
                                        <Setter Target="CacheSizeText.(Grid.Row)" Value="0" />
                                        <Setter Target="CacheSizeText.(Grid.Column)" Value="3" />
                                        <Setter Target="CacheItemActions.(Grid.Row)" Value="0" />
                                        <Setter Target="CacheItemActions.(Grid.Column)" Value="4" />
                                        <Setter Target="CacheItemActions.(Grid.ColumnSpan)" Value="1" />
                                        <Setter Target="CacheItemActions.Orientation" Value="Horizontal" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <TextBlock
                            x:Name="CacheNameText"
                            FontWeight="SemiBold"
                            Text="{Binding Name}"
                            TextWrapping="Wrap" />
                        <TextBlock
                            x:Name="CacheDirectoryText"
                            Grid.Column="1"
                            Text="{Binding DirectoryPath}"
                            TextTrimming="CharacterEllipsis"
                            ToolTipService.ToolTip="{Binding DirectoryPath}" />
                        <TextBlock
                            x:Name="CacheSourceText"
                            Grid.Column="2"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{Binding SourceText}"
                            TextTrimming="CharacterEllipsis"
                            ToolTipService.ToolTip="{Binding SourceText}" />
                        <TextBlock
                            x:Name="CacheSizeText"
                            Grid.Column="3"
                            Text="{Binding SizeText}"
                            TextWrapping="Wrap" />
                        <StackPanel
                            x:Name="CacheItemActions"
                            Grid.Column="4"
                            Orientation="Horizontal"
                            Spacing="8">
                            <Button
                                Click="OnOpenFolderClicked"
                                Content="打开"
                                IsEnabled="{Binding CanOpen}"
                                Tag="{Binding}"
                                ToolTipService.ToolTip="在文件资源管理器中打开实际目录" />
                            <Button
                                Click="OnMigrateClicked"
                                Content="迁移"
                                IsEnabled="{Binding CanMigrate}"
                                Tag="{Binding}" />
                            <Button
                                Click="OnCleanupClicked"
                                IsEnabled="{Binding CanClean}"
                                Tag="{Binding}"
                                ToolTipService.ToolTip="{Binding CleanupToolTip}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <SymbolIcon Symbol="Delete" />
                                    <TextBlock Text="清理" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
