<Page
    x:Class="AutoEnvPlus.App.Pages.LanguageDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid x:Name="DetailRoot">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>

        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="CompactDetailLayout">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="DetailHeader.Padding" Value="16,16,16,10" />
                        <Setter Target="DetailStatusInfo.Margin" Value="16,0,16,8" />
                        <Setter Target="OverviewContent.Padding" Value="16,12,16,24" />
                        <Setter Target="ToolContent.Padding" Value="16,12,16,24" />
                        <Setter Target="SourceContent.Padding" Value="16,12,16,24" />
                        <Setter Target="ProjectContent.Padding" Value="16,12,16,24" />
                        <Setter Target="ExtensionContent.Padding" Value="16,12,16,24" />
                        <Setter Target="HeaderActionColumn.Width" Value="0" />
                        <Setter Target="HeaderActionRow.Height" Value="Auto" />
                        <Setter Target="DetailHeaderActions.(Grid.Row)" Value="1" />
                        <Setter Target="DetailHeaderActions.(Grid.Column)" Value="1" />
                        <Setter Target="DetailHeaderActions.Margin" Value="0,8,0,0" />
                        <Setter Target="OverviewDetectedColumn.Width" Value="0" />
                        <Setter Target="OverviewManagedColumn.Width" Value="0" />
                        <Setter Target="OverviewDetectedRow.Height" Value="Auto" />
                        <Setter Target="OverviewManagedRow.Height" Value="Auto" />
                        <Setter Target="OverviewDetectedCard.(Grid.Row)" Value="1" />
                        <Setter Target="OverviewDetectedCard.(Grid.Column)" Value="0" />
                        <Setter Target="OverviewManagedCard.(Grid.Row)" Value="2" />
                        <Setter Target="OverviewManagedCard.(Grid.Column)" Value="0" />
                        <Setter Target="SourceActionColumn.Width" Value="0" />
                        <Setter Target="SourceActionRow.Height" Value="Auto" />
                        <Setter Target="AddSourceButton.(Grid.Row)" Value="1" />
                        <Setter Target="AddSourceButton.(Grid.Column)" Value="0" />
                        <Setter Target="AddSourceButton.HorizontalAlignment" Value="Left" />
                        <Setter Target="PluginActionColumn.Width" Value="0" />
                        <Setter Target="PluginActionRow.Height" Value="Auto" />
                        <Setter Target="ImportProviderButton.(Grid.Row)" Value="1" />
                        <Setter Target="ImportProviderButton.(Grid.Column)" Value="0" />
                        <Setter Target="ImportProviderButton.HorizontalAlignment" Value="Left" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="WideDetailLayout">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="760" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="DetailHeader.Padding" Value="32,20,32,12" />
                        <Setter Target="DetailStatusInfo.Margin" Value="32,0,32,8" />
                        <Setter Target="OverviewContent.Padding" Value="32,12,32,32" />
                        <Setter Target="ToolContent.Padding" Value="32,12,32,32" />
                        <Setter Target="SourceContent.Padding" Value="32,12,32,32" />
                        <Setter Target="ProjectContent.Padding" Value="32,12,32,32" />
                        <Setter Target="ExtensionContent.Padding" Value="32,12,32,32" />
                        <Setter Target="HeaderActionColumn.Width" Value="Auto" />
                        <Setter Target="HeaderActionRow.Height" Value="0" />
                        <Setter Target="DetailHeaderActions.(Grid.Row)" Value="0" />
                        <Setter Target="DetailHeaderActions.(Grid.Column)" Value="2" />
                        <Setter Target="DetailHeaderActions.Margin" Value="0" />
                        <Setter Target="OverviewDetectedColumn.Width" Value="*" />
                        <Setter Target="OverviewManagedColumn.Width" Value="*" />
                        <Setter Target="OverviewDetectedRow.Height" Value="0" />
                        <Setter Target="OverviewManagedRow.Height" Value="0" />
                        <Setter Target="OverviewDetectedCard.(Grid.Row)" Value="0" />
                        <Setter Target="OverviewDetectedCard.(Grid.Column)" Value="1" />
                        <Setter Target="OverviewManagedCard.(Grid.Row)" Value="0" />
                        <Setter Target="OverviewManagedCard.(Grid.Column)" Value="2" />
                        <Setter Target="SourceActionColumn.Width" Value="Auto" />
                        <Setter Target="SourceActionRow.Height" Value="0" />
                        <Setter Target="AddSourceButton.(Grid.Row)" Value="0" />
                        <Setter Target="AddSourceButton.(Grid.Column)" Value="1" />
                        <Setter Target="AddSourceButton.HorizontalAlignment" Value="Stretch" />
                        <Setter Target="PluginActionColumn.Width" Value="Auto" />
                        <Setter Target="PluginActionRow.Height" Value="0" />
                        <Setter Target="ImportProviderButton.(Grid.Row)" Value="0" />
                        <Setter Target="ImportProviderButton.(Grid.Column)" Value="1" />
                        <Setter Target="ImportProviderButton.HorizontalAlignment" Value="Stretch" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid x:Name="DetailHeader" Padding="32,20,32,12" ColumnSpacing="12" RowSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition />
                <ColumnDefinition x:Name="HeaderActionColumn" Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition x:Name="HeaderActionRow" Height="0" />
            </Grid.RowDefinitions>
            <Button
                AutomationProperties.Name="返回语言列表"
                Click="OnBackClicked"
                ToolTipService.ToolTip="返回语言列表">
                <SymbolIcon Symbol="Back" />
            </Button>
            <StackPanel Grid.Column="1" Spacing="3">
                <TextBlock x:Name="LanguageTitle" Style="{StaticResource TitleTextBlockStyle}" Text="语言" />
                <TextBlock
                    x:Name="LanguageSubtitle"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="编译器工具与运行时"
                    TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel
                x:Name="DetailHeaderActions"
                Grid.Column="2"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="8">
                <ProgressRing
                    x:Name="OperationProgress"
                    Width="20"
                    Height="20"
                    AutomationProperties.Name="语言工具操作进度"
                    IsActive="False" />
                <Button
                    x:Name="ScanLanguageButton"
                    AutomationProperties.Name="扫描当前语言"
                    Click="OnScanLanguageClicked"
                    ToolTipService.ToolTip="显式扫描当前语言的 PATH 与专用工具">
                    <SymbolIcon Symbol="Refresh" />
                </Button>
                <Button
                    x:Name="CancelOperationButton"
                    AutomationProperties.Name="取消当前操作"
                    Click="OnCancelOperationClicked"
                    IsEnabled="False"
                    ToolTipService.ToolTip="取消当前操作">
                    <SymbolIcon Symbol="Cancel" />
                </Button>
                <HyperlinkButton
                    x:Name="HomepageButton"
                    Content="官方主页" />
            </StackPanel>
        </Grid>

        <InfoBar
            x:Name="DetailStatusInfo"
            Grid.Row="1"
            Margin="32,0,32,8"
            AutomationProperties.LiveSetting="Polite"
            IsClosable="False"
            IsOpen="False" />

        <Pivot x:Name="DetailPivot" Grid.Row="2">
            <PivotItem Header="概览">
                <ScrollViewer>
                    <StackPanel x:Name="OverviewContent" Padding="32,12,32,32" Spacing="18">
                        <Grid ColumnSpacing="12" RowSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition x:Name="OverviewDetectedColumn" />
                                <ColumnDefinition x:Name="OverviewManagedColumn" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition />
                                <RowDefinition x:Name="OverviewDetectedRow" Height="0" />
                                <RowDefinition x:Name="OverviewManagedRow" Height="0" />
                            </Grid.RowDefinitions>
                            <Border
                                Padding="16"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource CardCornerRadius}">
                                <StackPanel Spacing="4">
                                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="语言工具" />
                                    <TextBlock x:Name="OverviewToolCount" FontSize="26" FontWeight="SemiBold" Text="—" />
                                </StackPanel>
                            </Border>
                            <Border
                                x:Name="OverviewDetectedCard"
                                Grid.Column="1"
                                Padding="16"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource CardCornerRadius}">
                                <StackPanel Spacing="4">
                                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="PATH 已检测" />
                                    <TextBlock x:Name="OverviewDetectedCount" FontSize="26" FontWeight="SemiBold" Text="—" />
                                </StackPanel>
                            </Border>
                            <Border
                                x:Name="OverviewManagedCard"
                                Grid.Column="2"
                                Padding="16"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource CardCornerRadius}">
                                <StackPanel Spacing="4">
                                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="AutoEnvPlus 安装适配器" TextWrapping="Wrap" />
                                    <TextBlock x:Name="OverviewManagedCount" FontSize="26" FontWeight="SemiBold" Text="—" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <StackPanel Spacing="8">
                            <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="语言定义" />
                            <Border
                                Padding="16"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource CardCornerRadius}">
                                <StackPanel Spacing="10">
                                    <TextBlock x:Name="LanguageIdText" IsTextSelectionEnabled="True" TextWrapping="Wrap" />
                                    <TextBlock x:Name="LanguageAliasesText" TextWrapping="Wrap" />
                                    <TextBlock x:Name="LanguageExtensionsText" TextWrapping="Wrap" />
                                    <TextBlock x:Name="LanguageVisibilityText" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <InfoBar
                            IsClosable="False"
                            IsOpen="True"
                            Message="语言是稳定配置容器；每个语言工具拥有自己的 Provider，Provider Source 只能在其归属 Provider 下配置。目录声明不会自动获得安装、切换或卸载能力。"
                            Severity="Informational"
                            Title="Language → Language Tool → Provider → Provider Source" />
                    </StackPanel>
                </ScrollViewer>
            </PivotItem>

            <PivotItem Header="工具与版本">
                <ScrollViewer>
                    <StackPanel x:Name="ToolContent" Padding="32,12,32,32" Spacing="14">
                        <InfoBar
                            IsClosable="False"
                            IsOpen="True"
                            Message="“AutoEnvPlus 操作”表示应用内有实际适配器；“目录元数据”只声明厂商、许可证、发现命令和 Provider。受管卸载只处理 AutoEnvPlus 注册的运行时，并在执行前重新检查全局和项目引用。"
                            Severity="Informational"
                            Title="操作能力以实际适配器为准" />
                        <ListView
                            x:Name="ToolList"
                            AutomationProperties.Name="当前语言的语言工具"
                            IsItemClickEnabled="False"
                            SelectionMode="None">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0,0,0,8" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Border
                                        Padding="16"
                                        AutomationProperties.Name="{Binding AutomationName}"
                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="{StaticResource CardCornerRadius}">
                                        <Grid ColumnSpacing="14" RowSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition />
                                                <ColumnDefinition x:Name="ToolActionColumn" Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition />
                                                <RowDefinition x:Name="ToolActionRow" Height="0" />
                                            </Grid.RowDefinitions>
                                            <VisualStateManager.VisualStateGroups>
                                                <VisualStateGroup>
                                                    <VisualState x:Name="CompactToolItem">
                                                        <VisualState.StateTriggers>
                                                            <AdaptiveTrigger MinWindowWidth="0" />
                                                        </VisualState.StateTriggers>
                                                        <VisualState.Setters>
                                                            <Setter Target="ToolActionColumn.Width" Value="0" />
                                                            <Setter Target="ToolActionRow.Height" Value="Auto" />
                                                            <Setter Target="ToolActions.(Grid.Row)" Value="1" />
                                                            <Setter Target="ToolActions.(Grid.Column)" Value="0" />
                                                            <Setter Target="ToolActions.HorizontalAlignment" Value="Left" />
                                                        </VisualState.Setters>
                                                    </VisualState>
                                                    <VisualState x:Name="WideToolItem">
                                                        <VisualState.StateTriggers>
                                                            <AdaptiveTrigger MinWindowWidth="720" />
                                                        </VisualState.StateTriggers>
                                                        <VisualState.Setters>
                                                            <Setter Target="ToolActionColumn.Width" Value="Auto" />
                                                            <Setter Target="ToolActionRow.Height" Value="0" />
                                                            <Setter Target="ToolActions.(Grid.Row)" Value="0" />
                                                            <Setter Target="ToolActions.(Grid.Column)" Value="1" />
                                                            <Setter Target="ToolActions.HorizontalAlignment" Value="Stretch" />
                                                        </VisualState.Setters>
                                                    </VisualState>
                                                </VisualStateGroup>
                                            </VisualStateManager.VisualStateGroups>
                                            <StackPanel Spacing="6">
                                                <TextBlock FontSize="17" FontWeight="SemiBold" Text="{Binding DisplayName}" TextWrapping="Wrap" />
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <Border
                                                        Padding="6,2"
                                                        Background="{ThemeResource AccentFillColorTertiaryBrush}"
                                                        CornerRadius="4"
                                                        Visibility="{Binding DetectedVisibility}">
                                                        <TextBlock FontSize="12" Text="已检测" />
                                                    </Border>
                                                    <Border
                                                        Padding="6,2"
                                                        Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}"
                                                        CornerRadius="4"
                                                        Visibility="{Binding ManagedVisibility}">
                                                        <TextBlock FontSize="12" Text="AutoEnvPlus 操作" />
                                                    </Border>
                                                    <Border
                                                        Padding="6,2"
                                                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                                        CornerRadius="4"
                                                        Visibility="{Binding MetadataVisibility}">
                                                        <TextBlock FontSize="12" Text="目录元数据" />
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Text="{Binding HierarchySummary}"
                                                    TextWrapping="Wrap" />
                                                <TextBlock
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Text="{Binding RoleSummary}"
                                                    TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding VersionSummary}" TextWrapping="Wrap" />
                                                <TextBlock
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Text="{Binding CatalogCapabilitySummary}"
                                                    TextWrapping="Wrap" />
                                                <TextBlock
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Text="{Binding ToolMetadataSummary}"
                                                    TextWrapping="Wrap" />
                                                <ItemsControl
                                                    AutomationProperties.Name="目录元数据外部链接"
                                                    ItemsSource="{Binding MetadataLinks}"
                                                    Visibility="{Binding MetadataVisibility}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <ItemsWrapGrid Orientation="Horizontal" />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <HyperlinkButton
                                                                Margin="0,0,8,0"
                                                                AutomationProperties.Name="{Binding AutomationName}"
                                                                Content="{Binding Label}"
                                                                NavigateUri="{Binding NavigateUri}" />
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <TextBlock
                                                    FontWeight="SemiBold"
                                                    Text="{Binding OperationSummary}"
                                                    TextWrapping="Wrap" />
                                                <TextBlock
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Text="{Binding ProviderSummary}"
                                                    TextWrapping="Wrap" />
                                            </StackPanel>
                                            <StackPanel
                                                x:Name="ToolActions"
                                                Grid.Column="1"
                                                VerticalAlignment="Center"
                                                Orientation="Horizontal"
                                                Spacing="8">
                                                <Button
                                                    Width="36"
                                                    Height="36"
                                                    Padding="0"
                                                    AutomationProperties.Name="{Binding SwitchActionAutomationName}"
                                                    Click="OnSwitchGlobalVersionClicked"
                                                    Tag="{Binding}"
                                                    ToolTipService.ToolTip="全局、项目或新终端会话"
                                                    Visibility="{Binding SwitchActionVisibility}">
                                                    <FontIcon FontSize="16" Glyph="&#xE895;" />
                                                </Button>
                                                <Button
                                                    Width="36"
                                                    Height="36"
                                                    Padding="0"
                                                    AutomationProperties.Name="{Binding UninstallActionAutomationName}"
                                                    Click="OnUninstallManagedRuntimeClicked"
                                                    Tag="{Binding}"
                                                    ToolTipService.ToolTip="卸载 AutoEnvPlus 受管版本"
                                                    Visibility="{Binding UninstallActionVisibility}">
                                                    <SymbolIcon Symbol="Delete" />
                                                </Button>
                                                <Button
                                                    VerticalAlignment="Center"
                                                    AutomationProperties.Name="{Binding ManageActionAutomationName}"
                                                    Click="OnManageToolClicked"
                                                    Content="{Binding ManageActionText}"
                                                    Tag="{Binding}"
                                                    Visibility="{Binding ManageActionVisibility}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <StackPanel
                            x:Name="EmptyToolState"
                            HorizontalAlignment="Center"
                            AutomationProperties.Name="当前语言没有可显示的语言工具"
                            Spacing="4"
                            Visibility="Collapsed">
                            <TextBlock HorizontalAlignment="Center" FontWeight="SemiBold" Text="没有可显示的语言工具" />
                            <TextBlock
                                HorizontalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="当前目录或实验性工具显示策略没有返回工具项。"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </PivotItem>

            <PivotItem Header="Provider 来源">
                <ScrollViewer>
                    <StackPanel x:Name="SourceContent" Padding="32,12,32,32" Spacing="14">
                        <InfoBar
                            x:Name="MirrorInfo"
                            AutomationProperties.LiveSetting="Polite"
                            IsClosable="False"
                            IsOpen="True"
                            Message="每个来源槽都保留 Language / Language Tool / Provider / Provider Source 四级归属；不会把同名端点应用到其他 Provider。HTTP/HTTPS 代理和 NO_PROXY 仍是通用传输策略。"
                            Severity="Informational"
                            Title="精确 Provider Source 归属" />
                        <Grid ColumnSpacing="12" RowSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition x:Name="SourceActionColumn" Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition />
                                <RowDefinition x:Name="SourceActionRow" Height="0" />
                            </Grid.RowDefinitions>
                            <StackPanel Spacing="4">
                                <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Language Tool / Provider / Provider Source" />
                                <TextBlock
                                    x:Name="PackageManagerSummary"
                                    AutomationProperties.LiveSetting="Polite"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                            <Button
                                x:Name="AddSourceButton"
                                Grid.Column="1"
                                AutomationProperties.Name="为当前语言的 Provider 添加自定义源"
                                Click="OnAddCustomSourceClicked">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <SymbolIcon Symbol="Add" />
                                    <TextBlock Text="添加自定义源" />
                                </StackPanel>
                            </Button>
                        </Grid>
                        <ListView
                            x:Name="MirrorList"
                            AutomationProperties.Name="当前语言的 Provider Source"
                            IsItemClickEnabled="False"
                            SelectionMode="None">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0,0,0,8" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Border
                                        Padding="16"
                                        AutomationProperties.Name="{Binding AutomationName}"
                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="{StaticResource CardCornerRadius}">
                                        <Grid ColumnSpacing="12" RowSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition />
                                                <ColumnDefinition x:Name="MirrorActionColumn" Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition />
                                                <RowDefinition x:Name="MirrorActionRow" Height="0" />
                                            </Grid.RowDefinitions>
                                            <VisualStateManager.VisualStateGroups>
                                                <VisualStateGroup>
                                                    <VisualState x:Name="CompactMirrorItem">
                                                        <VisualState.StateTriggers>
                                                            <AdaptiveTrigger MinWindowWidth="0" />
                                                        </VisualState.StateTriggers>
                                                        <VisualState.Setters>
                                                            <Setter Target="MirrorActionColumn.Width" Value="0" />
                                                            <Setter Target="MirrorActionRow.Height" Value="Auto" />
                                                            <Setter Target="MirrorActions.(Grid.Row)" Value="1" />
                                                            <Setter Target="MirrorActions.(Grid.Column)" Value="0" />
                                                            <Setter Target="MirrorActions.HorizontalAlignment" Value="Left" />
                                                        </VisualState.Setters>
                                                    </VisualState>
                                                    <VisualState x:Name="WideMirrorItem">
                                                        <VisualState.StateTriggers>
                                                            <AdaptiveTrigger MinWindowWidth="720" />
                                                        </VisualState.StateTriggers>
                                                        <VisualState.Setters>
                                                            <Setter Target="MirrorActionColumn.Width" Value="Auto" />
                                                            <Setter Target="MirrorActionRow.Height" Value="0" />
                                                            <Setter Target="MirrorActions.(Grid.Row)" Value="0" />
                                                            <Setter Target="MirrorActions.(Grid.Column)" Value="1" />
                                                            <Setter Target="MirrorActions.HorizontalAlignment" Value="Stretch" />
                                                        </VisualState.Setters>
                                                    </VisualState>
                                                </VisualStateGroup>
                                            </VisualStateManager.VisualStateGroups>
                                            <StackPanel Spacing="5">
                                                <TextBlock FontWeight="SemiBold" Text="{Binding DisplayName}" />
                                                <TextBlock Text="{Binding Ownership}" TextWrapping="Wrap" />
                                                <TextBlock
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    IsTextSelectionEnabled="True"
                                                    Text="{Binding Endpoint}"
                                                    TextWrapping="Wrap" />
                                                <TextBlock
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Text="{Binding Purpose}"
                                                    TextWrapping="Wrap" />
                                            </StackPanel>
                                            <StackPanel x:Name="MirrorActions" Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal" Spacing="6">
                                                <Button
                                                    AutomationProperties.Name="{Binding PrimaryActionAutomationName}"
                                                    Click="OnEditMirrorClicked"
                                                    Content="{Binding PrimaryActionText}"
                                                    IsEnabled="{Binding CanEdit}"
                                                    Tag="{Binding}" />
                                                <Button
                                                    AutomationProperties.Name="{Binding SecondaryActionText}"
                                                    Click="OnResetMirrorClicked"
                                                    Tag="{Binding}"
                                                    ToolTipService.ToolTip="{Binding SecondaryActionText}"
                                                    Visibility="{Binding SecondaryActionVisibility}">
                                                    <FontIcon Glyph="{Binding SecondaryGlyph}" />
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <StackPanel
                            x:Name="EmptyMirrorState"
                            AutomationProperties.Name="此语言的 Provider 暂未声明 Provider Source"
                            Spacing="4"
                            Visibility="Collapsed">
                            <TextBlock FontWeight="SemiBold" Text="没有 Provider Source" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="此语言的 Provider 暂未声明来源槽；通用代理策略仍可生效。"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </PivotItem>

            <PivotItem Header="项目环境">
                <ScrollViewer>
                    <StackPanel x:Name="ProjectContent" Padding="32,12,32,32" Spacing="14">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox
                                x:Name="ProjectPathBox"
                                AutomationProperties.Name="项目目录"
                                Header="项目目录"
                                PlaceholderText="选择一个项目目录" />
                            <Button
                                Grid.Column="1"
                                VerticalAlignment="Bottom"
                                AutomationProperties.Name="选择项目目录"
                                Click="OnChooseProjectFolderClicked"
                                ToolTipService.ToolTip="选择项目目录">
                                <SymbolIcon Symbol="Folder" />
                            </Button>
                        </Grid>
                        <Button
                            x:Name="ParseProjectButton"
                            HorizontalAlignment="Left"
                            Click="OnParseProjectClicked">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <SymbolIcon Symbol="Find" />
                                <TextBlock Text="解析虚拟环境" />
                            </StackPanel>
                        </Button>
                        <InfoBar
                            x:Name="ProjectInfo"
                            AutomationProperties.LiveSetting="Polite"
                            IsClosable="False"
                            IsOpen="True"
                            Message="只读取固定候选路径和项目元数据，不递归扫描、不跟随重解析点，也不执行外部命令。"
                            Severity="Informational"
                            Title="等待选择项目" />
                        <ListView
                            x:Name="ProjectEnvironmentList"
                            IsItemClickEnabled="False"
                            SelectionMode="None">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0,0,0,8" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Border
                                        Padding="14"
                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="{StaticResource CardCornerRadius}">
                                        <StackPanel Spacing="4">
                                            <TextBlock FontWeight="SemiBold" Text="{Binding Title}" />
                                            <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" />
                                            <TextBlock
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                IsTextSelectionEnabled="True"
                                                Text="{Binding Root}"
                                                TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </ScrollViewer>
            </PivotItem>

            <PivotItem Header="Provider 插件">
                <ScrollViewer>
                    <StackPanel x:Name="ExtensionContent" Padding="32,12,32,32" Spacing="14">
                        <Grid ColumnSpacing="12" RowSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition x:Name="PluginActionColumn" Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition />
                                <RowDefinition x:Name="PluginActionRow" Height="0" />
                            </Grid.RowDefinitions>
                            <StackPanel Spacing="3">
                                <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="此语言的 Provider 插件" />
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="只显示桥接到当前语言工具类型的插件；导入、启用和停用均留在此语言上下文。"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                            <Button
                                x:Name="ImportProviderButton"
                                Grid.Column="1"
                                AutomationProperties.Name="为当前语言导入 Provider 插件"
                                Click="OnImportProviderPluginClicked">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <SymbolIcon Symbol="OpenFile" />
                                    <TextBlock Text="导入 Provider" />
                                </StackPanel>
                            </Button>
                        </Grid>
                        <InfoBar
                            IsClosable="False"
                            IsOpen="True"
                            Message="语言工具 Provider 插件仍是受限声明式 ZIP 目录：不能加载 DLL、脚本、任意命令、注册表或环境钩子。第三方 checksum 不等于官方签名。"
                            Severity="Warning"
                            Title="插件信任边界" />
                        <ListView
                            x:Name="ProviderPluginList"
                            AutomationProperties.Name="当前语言的 Provider 插件"
                            IsItemClickEnabled="False"
                            SelectionMode="None">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0,0,0,8" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Border
                                        Padding="14"
                                        AutomationProperties.Name="{Binding AutomationName}"
                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="{StaticResource CardCornerRadius}">
                                        <Grid ColumnSpacing="12" RowSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition />
                                                <ColumnDefinition x:Name="PluginItemActionColumn" Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition />
                                                <RowDefinition x:Name="PluginItemActionRow" Height="0" />
                                            </Grid.RowDefinitions>
                                            <VisualStateManager.VisualStateGroups>
                                                <VisualStateGroup>
                                                    <VisualState x:Name="CompactPluginItem">
                                                        <VisualState.StateTriggers>
                                                            <AdaptiveTrigger MinWindowWidth="0" />
                                                        </VisualState.StateTriggers>
                                                        <VisualState.Setters>
                                                            <Setter Target="PluginItemActionColumn.Width" Value="0" />
                                                            <Setter Target="PluginItemActionRow.Height" Value="Auto" />
                                                            <Setter Target="PluginItemActions.(Grid.Row)" Value="1" />
                                                            <Setter Target="PluginItemActions.(Grid.Column)" Value="0" />
                                                            <Setter Target="PluginItemActions.HorizontalAlignment" Value="Left" />
                                                        </VisualState.Setters>
                                                    </VisualState>
                                                    <VisualState x:Name="WidePluginItem">
                                                        <VisualState.StateTriggers>
                                                            <AdaptiveTrigger MinWindowWidth="720" />
                                                        </VisualState.StateTriggers>
                                                        <VisualState.Setters>
                                                            <Setter Target="PluginItemActionColumn.Width" Value="Auto" />
                                                            <Setter Target="PluginItemActionRow.Height" Value="0" />
                                                            <Setter Target="PluginItemActions.(Grid.Row)" Value="0" />
                                                            <Setter Target="PluginItemActions.(Grid.Column)" Value="1" />
                                                            <Setter Target="PluginItemActions.HorizontalAlignment" Value="Stretch" />
                                                        </VisualState.Setters>
                                                    </VisualState>
                                                </VisualStateGroup>
                                            </VisualStateManager.VisualStateGroups>
                                            <StackPanel Spacing="4">
                                                <TextBlock FontWeight="SemiBold" Text="{Binding DisplayName}" />
                                                <TextBlock
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Text="{Binding Detail}"
                                                    TextWrapping="Wrap" />
                                            </StackPanel>
                                            <StackPanel x:Name="PluginItemActions" Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                                <Button
                                                    AutomationProperties.Name="{Binding ToggleAutomationName}"
                                                    Click="OnToggleProviderPluginClicked"
                                                    Content="{Binding ToggleText}"
                                                    Tag="{Binding}" />
                                                <Button
                                                    AutomationProperties.Name="{Binding DeleteAutomationName}"
                                                    Click="OnDeleteProviderPluginClicked"
                                                    Tag="{Binding}"
                                                    ToolTipService.ToolTip="删除 Provider 插件">
                                                    <SymbolIcon Symbol="Delete" />
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <TextBlock
                            x:Name="EmptyProviderPluginText"
                            AutomationProperties.Name="此语言没有 Provider 插件"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="此语言当前没有可桥接的语言工具 Provider 插件。" />
                    </StackPanel>
                </ScrollViewer>
            </PivotItem>
        </Pivot>
    </Grid>
</Page>
