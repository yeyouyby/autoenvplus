<Page
    x:Class="AutoEnvPlus.App.Pages.MirrorSourcesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="24,16,24,16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Spacing="2">
                <TextBlock
                    x:Name="PageTitleText"
                    FontSize="24"
                    FontWeight="SemiBold" />
                <TextBlock
                    x:Name="PageSubtitleText"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap" />
            </StackPanel>
            <Button
                x:Name="RefreshButton"
                Grid.Column="1"
                VerticalAlignment="Top"
                Click="OnRefreshClicked">
                <FontIcon FontSize="16" Glyph="&#xE72C;" />
            </Button>
        </Grid>

        <InfoBar
            x:Name="MirrorInfo"
            Grid.Row="1"
            IsClosable="False"
            IsOpen="False" />

        <Grid Grid.Row="2" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox
                x:Name="FilterBox"
                Grid.Column="0"
                MaxWidth="420"
                HorizontalAlignment="Left"
                TextChanged="OnFilterChanged" />
            <Button
                x:Name="AddCustomButton"
                Grid.Column="1"
                Click="OnAddCustomSourceClicked">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontSize="16" Glyph="&#xE710;" />
                    <TextBlock x:Name="AddCustomButtonText" />
                </StackPanel>
            </Button>
        </Grid>

        <Grid Grid.Row="3">
            <ListView
                x:Name="SourceList"
                IsItemClickEnabled="False"
                SelectionMode="None">
                <ListView.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock
                                    Margin="0,12,0,4"
                                    FontSize="15"
                                    FontWeight="SemiBold"
                                    Text="{Binding Key}" />
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </ListView.GroupStyle>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid ColumnSpacing="12" Padding="0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel
                                Grid.Column="0"
                                VerticalAlignment="Center"
                                Spacing="2">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock FontWeight="SemiBold" Text="{Binding DisplayName}" />
                                    <Border
                                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                                        CornerRadius="3"
                                        Padding="6,1">
                                        <TextBlock
                                            x:Name="OriginBadgeText"
                                            FontSize="11"
                                            Loaded="OnOriginBadgeLoaded"
                                            Foreground="{ThemeResource TextOnAccentFillColorDefaultBrush}" />
                                    </Border>
                                    <Border
                                        x:Name="DisabledBadge"
                                        Background="{ThemeResource ControlFillColorDefaultBrush}"
                                        CornerRadius="3"
                                        Padding="6,1"
                                        Loaded="OnDisabledBadgeLoaded"
                                        Visibility="Collapsed">
                                        <TextBlock
                                            x:Name="DisabledBadgeText"
                                            FontSize="11"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </Border>
                                </StackPanel>
                                <TextBlock
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{Binding OwnerText}" />
                                <TextBlock
                                    FontSize="12"
                                    IsTextSelectionEnabled="True"
                                    Text="{Binding EndpointText}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="NoWrap" />
                                <TextBlock
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                    Text="{Binding Purpose}"
                                    TextTrimming="CharacterEllipsis"
                                    Visibility="{Binding PurposeVisibility}" />
                            </StackPanel>
                            <StackPanel
                                Grid.Column="1"
                                HorizontalAlignment="Right"
                                Orientation="Horizontal"
                                Spacing="8"
                                VerticalAlignment="Center">
                                <Button
                                    x:Name="EditButton"
                                    Click="OnEditClicked"
                                    Loaded="OnEditButtonLoaded"
                                    Tag="{Binding}"
                                    Visibility="Collapsed">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon FontSize="14" Glyph="&#xE70F;" />
                                        <TextBlock x:Name="EditText" />
                                    </StackPanel>
                                </Button>
                                <Button
                                    x:Name="ResetButton"
                                    Click="OnResetClicked"
                                    Loaded="OnResetButtonLoaded"
                                    Tag="{Binding}"
                                    Visibility="Collapsed">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon FontSize="14" Glyph="&#xE72B;" />
                                        <TextBlock x:Name="ResetText" />
                                    </StackPanel>
                                </Button>
                                <Button
                                    x:Name="ToggleButton"
                                    Click="OnToggleClicked"
                                    Loaded="OnToggleButtonLoaded"
                                    Tag="{Binding}"
                                    Visibility="Collapsed">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon FontSize="14" Glyph="&#xE7B4;" />
                                        <TextBlock x:Name="ToggleText" />
                                    </StackPanel>
                                </Button>
                                <Button
                                    x:Name="DeleteButton"
                                    Click="OnDeleteClicked"
                                    Loaded="OnDeleteButtonLoaded"
                                    Tag="{Binding}"
                                    Visibility="Collapsed">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon FontSize="14" Glyph="&#xE74D;" />
                                        <TextBlock x:Name="DeleteText" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <TextBlock
                x:Name="EmptyText"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Visibility="Collapsed" />
        </Grid>
    </Grid>
</Page>
