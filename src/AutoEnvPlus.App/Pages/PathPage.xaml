<Page
    x:Class="AutoEnvPlus.App.Pages.PathPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Page.Resources>
        <Style x:Key="StretchPathListViewItemStyle" TargetType="ListViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
    </Page.Resources>

    <Grid
        x:Name="LayoutRoot"
        Padding="{StaticResource PagePadding}"
        RowSpacing="14">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="CompactLayout">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="PathHeaderActions.(Grid.Row)" Value="1" />
                        <Setter Target="PathHeaderActions.(Grid.Column)" Value="0" />
                        <Setter Target="PathHeaderActions.HorizontalAlignment" Value="Left" />
                        <Setter Target="PathHeaderActions.Margin" Value="0,12,0,0" />
                        <Setter Target="CommandRouteHeader.Visibility" Value="Collapsed" />
                        <Setter Target="PathDirectoryHeader.Visibility" Value="Collapsed" />
                        <Setter Target="SnapshotActions.(Grid.Row)" Value="1" />
                        <Setter Target="SnapshotActions.(Grid.Column)" Value="0" />
                        <Setter Target="SnapshotActions.HorizontalAlignment" Value="Left" />
                        <Setter Target="SnapshotActions.Margin" Value="0,10,0,0" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="WideLayout">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="760" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="PathHeaderActions.(Grid.Row)" Value="0" />
                        <Setter Target="PathHeaderActions.(Grid.Column)" Value="1" />
                        <Setter Target="PathHeaderActions.HorizontalAlignment" Value="Stretch" />
                        <Setter Target="PathHeaderActions.Margin" Value="0" />
                        <Setter Target="CommandRouteHeader.Visibility" Value="Visible" />
                        <Setter Target="PathDirectoryHeader.Visibility" Value="Visible" />
                        <Setter Target="SnapshotActions.(Grid.Row)" Value="0" />
                        <Setter Target="SnapshotActions.(Grid.Column)" Value="1" />
                        <Setter Target="SnapshotActions.HorizontalAlignment" Value="Stretch" />
                        <Setter Target="SnapshotActions.Margin" Value="0" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="12" RowSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Spacing="4">
                <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="PATH 与命令" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="用户 PATH 只配置一次 AutoEnvPlus Shim；后续全局、项目和会话切换不再重写 PATH。"
                    TextWrapping="Wrap" />
                <TextBlock
                    x:Name="ShimStateText"
                    AutomationProperties.LiveSetting="Polite"
                    FontWeight="SemiBold"
                    Text="正在读取 Shim 路由状态…"
                    TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel
                x:Name="PathHeaderActions"
                Grid.Column="1"
                VerticalAlignment="Bottom"
                Orientation="Horizontal"
                Spacing="8">
                <Button
                    x:Name="RefreshPathButton"
                    Width="36"
                    Height="36"
                    AutomationProperties.Name="刷新 PATH 与命令"
                    Click="OnRefreshPathClicked"
                    ToolTipService.ToolTip="刷新 PATH 与命令">
                    <FontIcon FontSize="14" Glyph="&#xE72C;" />
                </Button>
                <Button
                    x:Name="ActivateShimButton"
                    Click="OnActivateShimClicked">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="14" Glyph="&#xE73E;" />
                        <TextBlock Text="配置 AutoEnvPlus Shim" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <InfoBar
            x:Name="SummaryInfo"
            Grid.Row="1"
            AutomationProperties.LiveSetting="Polite"
            IsClosable="False"
            IsOpen="True" />

        <ItemsRepeater
            x:Name="SwitchScopeRepeater"
            Grid.Row="2">
            <ItemsRepeater.Layout>
                <UniformGridLayout
                    MinColumnSpacing="20"
                    MinItemWidth="180"
                    MinRowSpacing="8" />
            </ItemsRepeater.Layout>
            <ItemsRepeater.ItemTemplate>
                <DataTemplate>
                    <StackPanel Padding="8,4" Spacing="2">
                        <TextBlock FontWeight="SemiBold" Text="{Binding Scope}" />
                        <TextBlock Text="{Binding Priority}" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{Binding Detail}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </DataTemplate>
            </ItemsRepeater.ItemTemplate>
        </ItemsRepeater>

        <Pivot Grid.Row="3">
            <PivotItem Header="命令路由">
                <ListView
                    x:Name="CommandRouteList"
                    ItemContainerStyle="{StaticResource StretchPathListViewItemStyle}"
                    SelectionMode="None">
                    <ListView.Header>
                        <Grid
                            x:Name="CommandRouteHeader"
                            Padding="12,8"
                            ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition />
                                <ColumnDefinition Width="150" />
                            </Grid.ColumnDefinitions>
                            <TextBlock FontWeight="SemiBold" Text="命令" />
                            <TextBlock Grid.Column="1" FontWeight="SemiBold" Text="实际入口" />
                            <TextBlock Grid.Column="2" FontWeight="SemiBold" Text="路由状态" />
                        </Grid>
                    </ListView.Header>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="12,8" ColumnSpacing="12" RowSpacing="3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition x:Name="CommandNameColumn" Width="100" />
                                    <ColumnDefinition x:Name="CommandWinnerColumn" />
                                    <ColumnDefinition x:Name="CommandStateColumn" Width="150" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition x:Name="CommandWinnerRow" Height="0" />
                                    <RowDefinition x:Name="CommandStateRow" Height="0" />
                                </Grid.RowDefinitions>
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup>
                                        <VisualState x:Name="CompactCommandRouteItem">
                                            <VisualState.StateTriggers>
                                                <AdaptiveTrigger MinWindowWidth="0" />
                                            </VisualState.StateTriggers>
                                            <VisualState.Setters>
                                                <Setter Target="CommandNameColumn.Width" Value="*" />
                                                <Setter Target="CommandWinnerColumn.Width" Value="0" />
                                                <Setter Target="CommandStateColumn.Width" Value="0" />
                                                <Setter Target="CommandWinnerRow.Height" Value="Auto" />
                                                <Setter Target="CommandStateRow.Height" Value="Auto" />
                                                <Setter Target="CommandNameText.(Grid.ColumnSpan)" Value="3" />
                                                <Setter Target="CommandWinnerText.(Grid.Row)" Value="1" />
                                                <Setter Target="CommandWinnerText.(Grid.Column)" Value="0" />
                                                <Setter Target="CommandWinnerText.(Grid.ColumnSpan)" Value="3" />
                                                <Setter Target="CommandWinnerText.TextTrimming" Value="None" />
                                                <Setter Target="CommandWinnerText.TextWrapping" Value="WrapWholeWords" />
                                                <Setter Target="CommandStateText.(Grid.Row)" Value="2" />
                                                <Setter Target="CommandStateText.(Grid.Column)" Value="0" />
                                                <Setter Target="CommandStateText.(Grid.ColumnSpan)" Value="3" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="WideCommandRouteItem">
                                            <VisualState.StateTriggers>
                                                <AdaptiveTrigger MinWindowWidth="760" />
                                            </VisualState.StateTriggers>
                                            <VisualState.Setters>
                                                <Setter Target="CommandNameColumn.Width" Value="100" />
                                                <Setter Target="CommandWinnerColumn.Width" Value="*" />
                                                <Setter Target="CommandStateColumn.Width" Value="150" />
                                                <Setter Target="CommandWinnerRow.Height" Value="0" />
                                                <Setter Target="CommandStateRow.Height" Value="0" />
                                                <Setter Target="CommandNameText.(Grid.ColumnSpan)" Value="1" />
                                                <Setter Target="CommandWinnerText.(Grid.Row)" Value="0" />
                                                <Setter Target="CommandWinnerText.(Grid.Column)" Value="1" />
                                                <Setter Target="CommandWinnerText.(Grid.ColumnSpan)" Value="1" />
                                                <Setter Target="CommandWinnerText.TextTrimming" Value="CharacterEllipsis" />
                                                <Setter Target="CommandWinnerText.TextWrapping" Value="NoWrap" />
                                                <Setter Target="CommandStateText.(Grid.Row)" Value="0" />
                                                <Setter Target="CommandStateText.(Grid.Column)" Value="2" />
                                                <Setter Target="CommandStateText.(Grid.ColumnSpan)" Value="1" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <TextBlock
                                    x:Name="CommandNameText"
                                    FontWeight="SemiBold"
                                    Text="{Binding Command}"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    x:Name="CommandWinnerText"
                                    Grid.Column="1"
                                    IsTextSelectionEnabled="True"
                                    Text="{Binding Winner}"
                                    TextTrimming="CharacterEllipsis"
                                    ToolTipService.ToolTip="{Binding Winner}" />
                                <TextBlock
                                    x:Name="CommandStateText"
                                    Grid.Column="2"
                                    Text="{Binding State}"
                                    TextWrapping="Wrap" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </PivotItem>

            <PivotItem Header="PATH 目录">
                <ListView
                    x:Name="PathList"
                    IsItemClickEnabled="False"
                    ItemContainerStyle="{StaticResource StretchPathListViewItemStyle}"
                    SelectionMode="None">
                    <ListView.Header>
                        <Grid
                            x:Name="PathDirectoryHeader"
                            Padding="12,8"
                            ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="52" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition />
                                <ColumnDefinition Width="120" />
                            </Grid.ColumnDefinitions>
                            <TextBlock FontWeight="SemiBold" Text="顺序" />
                            <TextBlock Grid.Column="1" FontWeight="SemiBold" Text="作用域" />
                            <TextBlock Grid.Column="2" FontWeight="SemiBold" Text="目录" />
                            <TextBlock Grid.Column="3" FontWeight="SemiBold" Text="状态" />
                        </Grid>
                    </ListView.Header>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="12,8" ColumnSpacing="12" RowSpacing="3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition x:Name="PathIndexColumn" Width="52" />
                                    <ColumnDefinition x:Name="PathScopeColumn" Width="110" />
                                    <ColumnDefinition x:Name="PathValueColumn" />
                                    <ColumnDefinition x:Name="PathStatusColumn" Width="120" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition x:Name="PathScopeRow" Height="0" />
                                    <RowDefinition x:Name="PathValueRow" Height="0" />
                                    <RowDefinition x:Name="PathStatusRow" Height="0" />
                                </Grid.RowDefinitions>
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup>
                                        <VisualState x:Name="CompactPathItem">
                                            <VisualState.StateTriggers>
                                                <AdaptiveTrigger MinWindowWidth="0" />
                                            </VisualState.StateTriggers>
                                            <VisualState.Setters>
                                                <Setter Target="PathIndexColumn.Width" Value="*" />
                                                <Setter Target="PathScopeColumn.Width" Value="0" />
                                                <Setter Target="PathValueColumn.Width" Value="0" />
                                                <Setter Target="PathStatusColumn.Width" Value="0" />
                                                <Setter Target="PathScopeRow.Height" Value="Auto" />
                                                <Setter Target="PathValueRow.Height" Value="Auto" />
                                                <Setter Target="PathStatusRow.Height" Value="Auto" />
                                                <Setter Target="PathIndexText.(Grid.ColumnSpan)" Value="4" />
                                                <Setter Target="PathScopeText.(Grid.Row)" Value="1" />
                                                <Setter Target="PathScopeText.(Grid.Column)" Value="0" />
                                                <Setter Target="PathScopeText.(Grid.ColumnSpan)" Value="4" />
                                                <Setter Target="PathValueText.(Grid.Row)" Value="2" />
                                                <Setter Target="PathValueText.(Grid.Column)" Value="0" />
                                                <Setter Target="PathValueText.(Grid.ColumnSpan)" Value="4" />
                                                <Setter Target="PathValueText.TextTrimming" Value="None" />
                                                <Setter Target="PathValueText.TextWrapping" Value="WrapWholeWords" />
                                                <Setter Target="PathStatusText.(Grid.Row)" Value="3" />
                                                <Setter Target="PathStatusText.(Grid.Column)" Value="0" />
                                                <Setter Target="PathStatusText.(Grid.ColumnSpan)" Value="4" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="WidePathItem">
                                            <VisualState.StateTriggers>
                                                <AdaptiveTrigger MinWindowWidth="760" />
                                            </VisualState.StateTriggers>
                                            <VisualState.Setters>
                                                <Setter Target="PathIndexColumn.Width" Value="52" />
                                                <Setter Target="PathScopeColumn.Width" Value="110" />
                                                <Setter Target="PathValueColumn.Width" Value="*" />
                                                <Setter Target="PathStatusColumn.Width" Value="120" />
                                                <Setter Target="PathScopeRow.Height" Value="0" />
                                                <Setter Target="PathValueRow.Height" Value="0" />
                                                <Setter Target="PathStatusRow.Height" Value="0" />
                                                <Setter Target="PathIndexText.(Grid.ColumnSpan)" Value="1" />
                                                <Setter Target="PathScopeText.(Grid.Row)" Value="0" />
                                                <Setter Target="PathScopeText.(Grid.Column)" Value="1" />
                                                <Setter Target="PathScopeText.(Grid.ColumnSpan)" Value="1" />
                                                <Setter Target="PathValueText.(Grid.Row)" Value="0" />
                                                <Setter Target="PathValueText.(Grid.Column)" Value="2" />
                                                <Setter Target="PathValueText.(Grid.ColumnSpan)" Value="1" />
                                                <Setter Target="PathValueText.TextTrimming" Value="CharacterEllipsis" />
                                                <Setter Target="PathValueText.TextWrapping" Value="NoWrap" />
                                                <Setter Target="PathStatusText.(Grid.Row)" Value="0" />
                                                <Setter Target="PathStatusText.(Grid.Column)" Value="3" />
                                                <Setter Target="PathStatusText.(Grid.ColumnSpan)" Value="1" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <TextBlock
                                    x:Name="PathIndexText"
                                    Text="{Binding Index}"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    x:Name="PathScopeText"
                                    Grid.Column="1"
                                    Text="{Binding Scope}"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    x:Name="PathValueText"
                                    Grid.Column="2"
                                    Text="{Binding Path}"
                                    TextTrimming="CharacterEllipsis"
                                    ToolTipService.ToolTip="{Binding Path}" />
                                <TextBlock
                                    x:Name="PathStatusText"
                                    Grid.Column="3"
                                    Text="{Binding Status}"
                                    TextWrapping="Wrap" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </PivotItem>

            <PivotItem Header="回滚快照">
                <Grid Padding="0,8,0,0" RowSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition />
                    </Grid.RowDefinitions>

                    <Grid ColumnSpacing="12" RowSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock
                                FontSize="16"
                                FontWeight="SemiBold"
                                Text="用户 PATH 回滚" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="仅恢复 AutoEnvPlus 写入前的用户 PATH；系统 PATH 和 Shim 文件保持不变。"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel
                            x:Name="SnapshotActions"
                            Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="8">
                            <Button
                                x:Name="RefreshSnapshotsButton"
                                Width="36"
                                Height="36"
                                AutomationProperties.Name="刷新 PATH 快照"
                                Click="OnRefreshSnapshotsClicked"
                                ToolTipService.ToolTip="刷新 PATH 快照">
                                <FontIcon FontSize="14" Glyph="&#xE72C;" />
                            </Button>
                            <Button
                                x:Name="RollbackPathButton"
                                MinWidth="124"
                                Height="36"
                                AutomationProperties.Name="回滚用户 PATH"
                                Click="OnRollbackPathClicked"
                                IsEnabled="False">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon FontSize="14" Glyph="&#xE7A7;" />
                                    <TextBlock Text="回滚用户 PATH" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <TextBlock
                        x:Name="SnapshotSummaryText"
                        Grid.Row="1"
                        AutomationProperties.LiveSetting="Polite"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="正在读取 PATH 快照…"
                        TextWrapping="Wrap" />

                    <Grid Grid.Row="2">
                        <ListView
                            x:Name="SnapshotList"
                            MaxHeight="260"
                            SelectionChanged="OnSnapshotSelectionChanged"
                            SelectionMode="Single"
                            Visibility="Collapsed">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="10,6" ColumnSpacing="12" RowSpacing="2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock FontWeight="SemiBold" Text="{Binding CreatedAt}" />
                                        <TextBlock Grid.Column="1" Text="{Binding State}" />
                                        <TextBlock
                                            Grid.Row="1"
                                            Grid.ColumnSpan="2"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{Binding AddedDirectory}"
                                            TextTrimming="CharacterEllipsis"
                                            ToolTipService.ToolTip="{Binding SnapshotPath}" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <TextBlock
                            x:Name="SnapshotEmptyText"
                            Padding="10,6"
                            AutomationProperties.LiveSetting="Polite"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="尚未创建 PATH 快照。" />
                    </Grid>
                </Grid>
            </PivotItem>
        </Pivot>
    </Grid>
</Page>
