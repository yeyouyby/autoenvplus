<Page
    x:Class="AutoEnvPlus.App.Pages.ActivityPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid
        x:Name="LayoutRoot"
        Padding="{StaticResource PagePadding}"
        RowSpacing="16">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="CompactLayout">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="StatusFilterColumn.Width" Value="*" />
                        <Setter Target="TypeFilterColumn.Width" Value="0" />
                        <Setter Target="FilterNoteColumn.Width" Value="0" />
                        <Setter Target="TypeFilterRow.Height" Value="Auto" />
                        <Setter Target="FilterNoteRow.Height" Value="Auto" />
                        <Setter Target="TypeFilter.(Grid.Row)" Value="1" />
                        <Setter Target="TypeFilter.(Grid.Column)" Value="0" />
                        <Setter Target="FilterNoteText.(Grid.Row)" Value="2" />
                        <Setter Target="FilterNoteText.(Grid.Column)" Value="0" />
                        <Setter Target="FilterNoteText.Margin" Value="0" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="WideLayout">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="760" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="StatusFilterColumn.Width" Value="220" />
                        <Setter Target="TypeFilterColumn.Width" Value="260" />
                        <Setter Target="FilterNoteColumn.Width" Value="*" />
                        <Setter Target="TypeFilterRow.Height" Value="0" />
                        <Setter Target="FilterNoteRow.Height" Value="0" />
                        <Setter Target="TypeFilter.(Grid.Row)" Value="0" />
                        <Setter Target="TypeFilter.(Grid.Column)" Value="1" />
                        <Setter Target="FilterNoteText.(Grid.Row)" Value="0" />
                        <Setter Target="FilterNoteText.(Grid.Column)" Value="2" />
                        <Setter Target="FilterNoteText.Margin" Value="0,28,0,0" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="4">
                <TextBlock x:Name="PageTitleText" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock
                    x:Name="PageSubtitleText"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap" />
            </StackPanel>
            <Button
                x:Name="RefreshButton"
                Grid.Column="1"
                Width="40"
                Height="40"
                Click="OnRefreshClicked">
                <FontIcon FontSize="16" Glyph="&#xE72C;" />
            </Button>
        </Grid>

        <Grid Grid.Row="1" ColumnSpacing="12" RowSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="StatusFilterColumn" Width="220" />
                <ColumnDefinition x:Name="TypeFilterColumn" Width="260" />
                <ColumnDefinition x:Name="FilterNoteColumn" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition x:Name="TypeFilterRow" Height="0" />
                <RowDefinition x:Name="FilterNoteRow" Height="0" />
            </Grid.RowDefinitions>
            <ComboBox
                x:Name="StatusFilter"
                SelectionChanged="OnFilterChanged">
                <ComboBoxItem x:Name="StatusFilterAllItem" />
                <ComboBoxItem x:Name="StatusFilterSucceededItem" />
                <ComboBoxItem x:Name="StatusFilterFailedItem" />
                <ComboBoxItem x:Name="StatusFilterCancelledItem" />
            </ComboBox>
            <ComboBox
                x:Name="TypeFilter"
                Grid.Column="1"
                SelectionChanged="OnFilterChanged">
                <ComboBoxItem x:Name="TypeFilterAllItem" />
            </ComboBox>
            <TextBlock
                x:Name="FilterNoteText"
                Grid.Column="2"
                Margin="0,28,0,0"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextWrapping="Wrap" />
        </Grid>

        <InfoBar
            x:Name="ActivityInfo"
            Grid.Row="2"
            AutomationProperties.LiveSetting="Polite"
            IsClosable="False"
            IsOpen="True"
            Severity="Informational" />

        <Grid Grid.Row="3">
            <ListView
                x:Name="ActivityList"
                IsItemClickEnabled="False"
                SelectionMode="None">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border
                            Padding="16"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                            <Grid RowSpacing="6" ColumnSpacing="12">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition x:Name="ActivityActionsRow" Height="0" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition x:Name="ActivityActionsColumn" Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup>
                                        <VisualState x:Name="CompactActivityItem">
                                            <VisualState.StateTriggers>
                                                <AdaptiveTrigger MinWindowWidth="0" />
                                            </VisualState.StateTriggers>
                                            <VisualState.Setters>
                                                <Setter Target="ActivityActionsColumn.Width" Value="0" />
                                                <Setter Target="ActivityActionsRow.Height" Value="Auto" />
                                                <Setter Target="ActivityHeader.Orientation" Value="Vertical" />
                                                <Setter Target="CopySummaryButton.(Grid.Row)" Value="5" />
                                                <Setter Target="CopySummaryButton.(Grid.Column)" Value="0" />
                                                <Setter Target="CopySummaryButton.HorizontalAlignment" Value="Left" />
                                                <Setter Target="CopySummaryButton.Margin" Value="0,4,0,0" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="WideActivityItem">
                                            <VisualState.StateTriggers>
                                                <AdaptiveTrigger MinWindowWidth="760" />
                                            </VisualState.StateTriggers>
                                            <VisualState.Setters>
                                                <Setter Target="ActivityActionsColumn.Width" Value="Auto" />
                                                <Setter Target="ActivityActionsRow.Height" Value="0" />
                                                <Setter Target="ActivityHeader.Orientation" Value="Horizontal" />
                                                <Setter Target="CopySummaryButton.(Grid.Row)" Value="0" />
                                                <Setter Target="CopySummaryButton.(Grid.Column)" Value="1" />
                                                <Setter Target="CopySummaryButton.HorizontalAlignment" Value="Stretch" />
                                                <Setter Target="CopySummaryButton.Margin" Value="0" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <StackPanel
                                    x:Name="ActivityHeader"
                                    Orientation="Horizontal"
                                    Spacing="10">
                                    <TextBlock FontWeight="SemiBold" Text="{Binding OperationText}" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" />
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{Binding TimestampText}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                                <Button
                                    x:Name="CopySummaryButton"
                                    Grid.Column="1"
                                    AutomationProperties.Name="{Binding CopyActionAutomationName}"
                                    Click="OnCopyClicked"
                                    Loaded="OnCopySummaryButtonLoaded"
                                    Tag="{Binding}" />
                                <TextBlock
                                    Grid.Row="1"
                                    Grid.ColumnSpan="2"
                                    IsTextSelectionEnabled="True"
                                    Text="{Binding Summary}"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    Grid.Row="2"
                                    Grid.ColumnSpan="2"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    IsTextSelectionEnabled="True"
                                    Text="{Binding AffectedPathsText}"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    Grid.Row="3"
                                    Grid.ColumnSpan="2"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    IsTextSelectionEnabled="True"
                                    Text="{Binding SnapshotText}"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    Grid.Row="4"
                                    Grid.ColumnSpan="2"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    IsTextSelectionEnabled="True"
                                    Text="{Binding RollbackText}"
                                    TextWrapping="Wrap" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <TextBlock
                x:Name="EmptyText"
                AutomationProperties.LiveSetting="Polite"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextAlignment="Center"
                TextWrapping="Wrap"
                Visibility="Collapsed" />
        </Grid>
    </Grid>
</Page>
