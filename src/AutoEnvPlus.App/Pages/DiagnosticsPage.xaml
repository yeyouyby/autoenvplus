<Page
    x:Class="AutoEnvPlus.App.Pages.DiagnosticsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Page.Resources>
        <Style x:Key="StretchDiagnosticListViewItemStyle" TargetType="ListViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
    </Page.Resources>

    <Grid
        x:Name="LayoutRoot"
        Padding="{StaticResource PagePadding}"
        RowSpacing="14">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="CompactLayout">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="DiagnosticHeaderActions.(Grid.Row)" Value="1" />
                        <Setter Target="DiagnosticHeaderActions.(Grid.Column)" Value="0" />
                        <Setter Target="DiagnosticHeaderActions.HorizontalAlignment" Value="Left" />
                        <Setter Target="DiagnosticHeaderActions.Margin" Value="0,12,0,0" />
                        <Setter Target="DiagnosticHeaderActions.Orientation" Value="Vertical" />

                        <Setter Target="ScopePrimaryColumn.Width" Value="*" />
                        <Setter Target="ScopeSecondaryColumn.Width" Value="0" />
                        <Setter Target="ScopeRow5.Height" Value="Auto" />
                        <Setter Target="ScopeRow6.Height" Value="Auto" />
                        <Setter Target="ScopeRow7.Height" Value="Auto" />
                        <Setter Target="ManagedScopeCheckBox.(Grid.Row)" Value="1" />
                        <Setter Target="ManagedScopeCheckBox.(Grid.Column)" Value="0" />
                        <Setter Target="ProviderScopeCheckBox.(Grid.Row)" Value="2" />
                        <Setter Target="ProjectScopeCheckBox.(Grid.Row)" Value="3" />
                        <Setter Target="ProjectScopeCheckBox.(Grid.Column)" Value="0" />
                        <Setter Target="StorageScopeCheckBox.(Grid.Row)" Value="4" />
                        <Setter Target="ConnectivityScopeCheckBox.(Grid.Row)" Value="5" />
                        <Setter Target="ConnectivityScopeCheckBox.(Grid.Column)" Value="0" />
                        <Setter Target="ProjectPathPicker.(Grid.Row)" Value="6" />
                        <Setter Target="ProjectPathPicker.(Grid.ColumnSpan)" Value="1" />
                        <Setter Target="ScopeHintText.(Grid.Row)" Value="7" />
                        <Setter Target="ScopeHintText.(Grid.ColumnSpan)" Value="1" />
                        <Setter Target="CommandHeader.Visibility" Value="Collapsed" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="WideLayout">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="760" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="DiagnosticHeaderActions.(Grid.Row)" Value="0" />
                        <Setter Target="DiagnosticHeaderActions.(Grid.Column)" Value="1" />
                        <Setter Target="DiagnosticHeaderActions.HorizontalAlignment" Value="Stretch" />
                        <Setter Target="DiagnosticHeaderActions.Margin" Value="0" />
                        <Setter Target="DiagnosticHeaderActions.Orientation" Value="Horizontal" />

                        <Setter Target="ScopePrimaryColumn.Width" Value="*" />
                        <Setter Target="ScopeSecondaryColumn.Width" Value="*" />
                        <Setter Target="ScopeRow5.Height" Value="0" />
                        <Setter Target="ScopeRow6.Height" Value="0" />
                        <Setter Target="ScopeRow7.Height" Value="0" />
                        <Setter Target="ManagedScopeCheckBox.(Grid.Row)" Value="0" />
                        <Setter Target="ManagedScopeCheckBox.(Grid.Column)" Value="1" />
                        <Setter Target="ProviderScopeCheckBox.(Grid.Row)" Value="1" />
                        <Setter Target="ProjectScopeCheckBox.(Grid.Row)" Value="1" />
                        <Setter Target="ProjectScopeCheckBox.(Grid.Column)" Value="1" />
                        <Setter Target="StorageScopeCheckBox.(Grid.Row)" Value="2" />
                        <Setter Target="ConnectivityScopeCheckBox.(Grid.Row)" Value="2" />
                        <Setter Target="ConnectivityScopeCheckBox.(Grid.Column)" Value="1" />
                        <Setter Target="ProjectPathPicker.(Grid.Row)" Value="3" />
                        <Setter Target="ProjectPathPicker.(Grid.ColumnSpan)" Value="2" />
                        <Setter Target="ScopeHintText.(Grid.Row)" Value="4" />
                        <Setter Target="ScopeHintText.(Grid.ColumnSpan)" Value="2" />
                        <Setter Target="CommandHeader.Visibility" Value="Visible" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="12" RowSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Spacing="4">
                <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="环境诊断" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="选择需要的扫描域；只读取真实状态，项目、缓存和联网检查不会自动运行。"
                    TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel
                x:Name="DiagnosticHeaderActions"
                Grid.Column="1"
                VerticalAlignment="Bottom"
                Orientation="Horizontal"
                Spacing="8">
                <ProgressRing
                    x:Name="DiagnosticProgress"
                    Width="20"
                    Height="20"
                    AutomationProperties.Name="诊断扫描进度"
                    IsActive="False" />
                <Button
                    x:Name="ExportButton"
                    Click="OnExportClicked"
                    IsEnabled="False"
                    ToolTipService.ToolTip="导出当前结构化诊断报告">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <SymbolIcon Symbol="Save" />
                        <TextBlock Text="导出 JSON" />
                    </StackPanel>
                </Button>
                <Button
                    x:Name="CancelButton"
                    Width="36"
                    Height="36"
                    AutomationProperties.Name="取消诊断"
                    Click="OnCancelClicked"
                    IsEnabled="False"
                    ToolTipService.ToolTip="取消当前诊断">
                    <SymbolIcon Symbol="Cancel" />
                </Button>
                <Button
                    x:Name="RefreshButton"
                    Click="OnRefreshClicked"
                    ToolTipService.ToolTip="按所选范围执行只读诊断">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <SymbolIcon Symbol="Play" />
                        <TextBlock Text="开始扫描" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <Expander
            x:Name="ScopeExpander"
            Grid.Row="1"
            Header="扫描范围"
            IsExpanded="True">
            <Grid Padding="0,8,0,4" ColumnSpacing="20" RowSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="ScopePrimaryColumn" />
                    <ColumnDefinition x:Name="ScopeSecondaryColumn" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition x:Name="ScopeRow5" Height="0" />
                    <RowDefinition x:Name="ScopeRow6" Height="0" />
                    <RowDefinition x:Name="ScopeRow7" Height="0" />
                </Grid.RowDefinitions>

                <CheckBox
                    x:Name="PathScopeCheckBox"
                    Click="OnScopeSelectionChanged"
                    Content="PATH、命令与 Shim"
                    IsChecked="True" />
                <CheckBox
                    x:Name="ManagedScopeCheckBox"
                    Grid.Column="1"
                    Click="OnScopeSelectionChanged"
                    Content="托管语言工具与版本选择"
                    IsChecked="True" />
                <CheckBox
                    x:Name="ProviderScopeCheckBox"
                    Grid.Row="1"
                    Click="OnScopeSelectionChanged"
                    Content="Provider 与来源配置"
                    IsChecked="True" />
                <CheckBox
                    x:Name="ProjectScopeCheckBox"
                    Grid.Row="1"
                    Grid.Column="1"
                    Click="OnProjectScopeChanged"
                    Content="项目选择与虚拟环境" />
                <CheckBox
                    x:Name="StorageScopeCheckBox"
                    Grid.Row="2"
                    Click="OnScopeSelectionChanged"
                    Content="缓存、暂存与磁盘（较慢）" />
                <CheckBox
                    x:Name="ConnectivityScopeCheckBox"
                    Grid.Row="2"
                    Grid.Column="1"
                    Click="OnScopeSelectionChanged"
                    Content="Provider 来源实时连接（较慢）" />

                <Grid
                    x:Name="ProjectPathPicker"
                    Grid.Row="3"
                    Grid.ColumnSpan="2"
                    ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox
                        x:Name="ProjectPathTextBox"
                        AutomationProperties.Name="诊断项目目录"
                        IsEnabled="False"
                        IsReadOnly="True"
                        PlaceholderText="选择项目目录" />
                    <Button
                        x:Name="BrowseProjectButton"
                        Grid.Column="1"
                        Height="36"
                        AutomationProperties.Name="选择诊断项目目录"
                        Click="OnBrowseProjectClicked"
                        IsEnabled="False"
                        ToolTipService.ToolTip="选择项目目录">
                        <FontIcon FontSize="14" Glyph="&#xE8B7;" />
                    </Button>
                </Grid>

                <TextBlock
                    x:Name="ScopeHintText"
                    Grid.Row="4"
                    Grid.ColumnSpan="2"
                    AutomationProperties.LiveSetting="Polite"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="已选择 3 个扫描域；不会遍历项目、缓存或访问网络。"
                    TextWrapping="Wrap" />
            </Grid>
        </Expander>

        <InfoBar
            x:Name="SummaryInfo"
            Grid.Row="2"
            AutomationProperties.LiveSetting="Polite"
            IsClosable="False"
            IsOpen="True"
            Message="选择范围后开始扫描；所有检查均为只读。"
            Severity="Informational"
            Title="等待扫描" />

        <Pivot Grid.Row="3">
            <PivotItem Header="扫描摘要">
                <ListView
                    x:Name="ScopeList"
                    ItemContainerStyle="{StaticResource StretchDiagnosticListViewItemStyle}"
                    SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="12,9" ColumnSpacing="12" RowSpacing="3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition x:Name="ScopeNameColumn" Width="180" />
                                    <ColumnDefinition x:Name="ScopeResultColumn" Width="100" />
                                    <ColumnDefinition x:Name="ScopeDetailColumn" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition x:Name="ScopeResultRow" Height="0" />
                                    <RowDefinition x:Name="ScopeDetailRow" Height="0" />
                                </Grid.RowDefinitions>
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup>
                                        <VisualState x:Name="CompactScopeItem">
                                            <VisualState.StateTriggers>
                                                <AdaptiveTrigger MinWindowWidth="0" />
                                            </VisualState.StateTriggers>
                                            <VisualState.Setters>
                                                <Setter Target="ScopeNameColumn.Width" Value="*" />
                                                <Setter Target="ScopeResultColumn.Width" Value="0" />
                                                <Setter Target="ScopeDetailColumn.Width" Value="0" />
                                                <Setter Target="ScopeResultRow.Height" Value="Auto" />
                                                <Setter Target="ScopeDetailRow.Height" Value="Auto" />
                                                <Setter Target="ScopeNameText.(Grid.ColumnSpan)" Value="3" />
                                                <Setter Target="ScopeResultText.(Grid.Row)" Value="1" />
                                                <Setter Target="ScopeResultText.(Grid.Column)" Value="0" />
                                                <Setter Target="ScopeResultText.(Grid.ColumnSpan)" Value="3" />
                                                <Setter Target="ScopeDetailText.(Grid.Row)" Value="2" />
                                                <Setter Target="ScopeDetailText.(Grid.Column)" Value="0" />
                                                <Setter Target="ScopeDetailText.(Grid.ColumnSpan)" Value="3" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="WideScopeItem">
                                            <VisualState.StateTriggers>
                                                <AdaptiveTrigger MinWindowWidth="760" />
                                            </VisualState.StateTriggers>
                                            <VisualState.Setters>
                                                <Setter Target="ScopeNameColumn.Width" Value="180" />
                                                <Setter Target="ScopeResultColumn.Width" Value="100" />
                                                <Setter Target="ScopeDetailColumn.Width" Value="*" />
                                                <Setter Target="ScopeResultRow.Height" Value="0" />
                                                <Setter Target="ScopeDetailRow.Height" Value="0" />
                                                <Setter Target="ScopeNameText.(Grid.ColumnSpan)" Value="1" />
                                                <Setter Target="ScopeResultText.(Grid.Row)" Value="0" />
                                                <Setter Target="ScopeResultText.(Grid.Column)" Value="1" />
                                                <Setter Target="ScopeResultText.(Grid.ColumnSpan)" Value="1" />
                                                <Setter Target="ScopeDetailText.(Grid.Row)" Value="0" />
                                                <Setter Target="ScopeDetailText.(Grid.Column)" Value="2" />
                                                <Setter Target="ScopeDetailText.(Grid.ColumnSpan)" Value="1" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <TextBlock
                                    x:Name="ScopeNameText"
                                    FontWeight="SemiBold"
                                    Text="{Binding Scope}"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    x:Name="ScopeResultText"
                                    Grid.Column="1"
                                    Text="{Binding Result}"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    x:Name="ScopeDetailText"
                                    Grid.Column="2"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{Binding Detail}"
                                    TextWrapping="Wrap" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </PivotItem>

            <PivotItem Header="问题">
                <ListView
                    x:Name="IssueList"
                    ItemContainerStyle="{StaticResource StretchDiagnosticListViewItemStyle}"
                    SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="12,10" ColumnSpacing="12" RowSpacing="3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition x:Name="IssueScopeColumn" Width="130" />
                                    <ColumnDefinition x:Name="IssueSeverityColumn" Width="64" />
                                    <ColumnDefinition x:Name="IssueDetailColumn" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition x:Name="IssueSeverityRow" Height="0" />
                                    <RowDefinition x:Name="IssueDetailRow" Height="0" />
                                </Grid.RowDefinitions>
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup>
                                        <VisualState x:Name="CompactIssueItem">
                                            <VisualState.StateTriggers>
                                                <AdaptiveTrigger MinWindowWidth="0" />
                                            </VisualState.StateTriggers>
                                            <VisualState.Setters>
                                                <Setter Target="IssueScopeColumn.Width" Value="*" />
                                                <Setter Target="IssueSeverityColumn.Width" Value="0" />
                                                <Setter Target="IssueDetailColumn.Width" Value="0" />
                                                <Setter Target="IssueSeverityRow.Height" Value="Auto" />
                                                <Setter Target="IssueDetailRow.Height" Value="Auto" />
                                                <Setter Target="IssueScopeText.(Grid.ColumnSpan)" Value="3" />
                                                <Setter Target="IssueSeverityText.(Grid.Row)" Value="1" />
                                                <Setter Target="IssueSeverityText.(Grid.Column)" Value="0" />
                                                <Setter Target="IssueSeverityText.(Grid.ColumnSpan)" Value="3" />
                                                <Setter Target="IssueDetailPanel.(Grid.Row)" Value="2" />
                                                <Setter Target="IssueDetailPanel.(Grid.Column)" Value="0" />
                                                <Setter Target="IssueDetailPanel.(Grid.ColumnSpan)" Value="3" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="WideIssueItem">
                                            <VisualState.StateTriggers>
                                                <AdaptiveTrigger MinWindowWidth="760" />
                                            </VisualState.StateTriggers>
                                            <VisualState.Setters>
                                                <Setter Target="IssueScopeColumn.Width" Value="130" />
                                                <Setter Target="IssueSeverityColumn.Width" Value="64" />
                                                <Setter Target="IssueDetailColumn.Width" Value="*" />
                                                <Setter Target="IssueSeverityRow.Height" Value="0" />
                                                <Setter Target="IssueDetailRow.Height" Value="0" />
                                                <Setter Target="IssueScopeText.(Grid.ColumnSpan)" Value="1" />
                                                <Setter Target="IssueSeverityText.(Grid.Row)" Value="0" />
                                                <Setter Target="IssueSeverityText.(Grid.Column)" Value="1" />
                                                <Setter Target="IssueSeverityText.(Grid.ColumnSpan)" Value="1" />
                                                <Setter Target="IssueDetailPanel.(Grid.Row)" Value="0" />
                                                <Setter Target="IssueDetailPanel.(Grid.Column)" Value="2" />
                                                <Setter Target="IssueDetailPanel.(Grid.ColumnSpan)" Value="1" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <TextBlock
                                    x:Name="IssueScopeText"
                                    FontWeight="SemiBold"
                                    Text="{Binding Scope}"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    x:Name="IssueSeverityText"
                                    Grid.Column="1"
                                    FontWeight="SemiBold"
                                    Foreground="{Binding SeverityBrush}"
                                    Text="{Binding Severity}" />
                                <StackPanel
                                    x:Name="IssueDetailPanel"
                                    Grid.Column="2"
                                    Spacing="3">
                                    <TextBlock
                                        FontWeight="SemiBold"
                                        Text="{Binding Title}"
                                        TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" />
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        IsTextSelectionEnabled="True"
                                        Text="{Binding Path}"
                                        TextWrapping="WrapWholeWords"
                                        Visibility="{Binding PathVisibility}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </PivotItem>

            <PivotItem Header="命令路由">
                <ListView
                    x:Name="CommandList"
                    ItemContainerStyle="{StaticResource StretchDiagnosticListViewItemStyle}"
                    SelectionMode="None">
                    <ListView.Header>
                        <Grid
                            x:Name="CommandHeader"
                            Padding="12,8"
                            ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition />
                                <ColumnDefinition Width="120" />
                            </Grid.ColumnDefinitions>
                            <TextBlock FontWeight="SemiBold" Text="命令" />
                            <TextBlock Grid.Column="1" FontWeight="SemiBold" Text="实际入口" />
                            <TextBlock Grid.Column="2" FontWeight="SemiBold" Text="候选" />
                        </Grid>
                    </ListView.Header>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="12,8" ColumnSpacing="12" RowSpacing="3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition x:Name="CommandNameColumn" Width="110" />
                                    <ColumnDefinition x:Name="CommandWinnerColumn" />
                                    <ColumnDefinition x:Name="CommandCandidateColumn" Width="120" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition x:Name="CommandWinnerRow" Height="0" />
                                    <RowDefinition x:Name="CommandCandidateRow" Height="0" />
                                </Grid.RowDefinitions>
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup>
                                        <VisualState x:Name="CompactCommandItem">
                                            <VisualState.StateTriggers>
                                                <AdaptiveTrigger MinWindowWidth="0" />
                                            </VisualState.StateTriggers>
                                            <VisualState.Setters>
                                                <Setter Target="CommandNameColumn.Width" Value="*" />
                                                <Setter Target="CommandWinnerColumn.Width" Value="0" />
                                                <Setter Target="CommandCandidateColumn.Width" Value="0" />
                                                <Setter Target="CommandWinnerRow.Height" Value="Auto" />
                                                <Setter Target="CommandCandidateRow.Height" Value="Auto" />
                                                <Setter Target="CommandNameText.(Grid.ColumnSpan)" Value="3" />
                                                <Setter Target="CommandWinnerText.(Grid.Row)" Value="1" />
                                                <Setter Target="CommandWinnerText.(Grid.Column)" Value="0" />
                                                <Setter Target="CommandWinnerText.(Grid.ColumnSpan)" Value="3" />
                                                <Setter Target="CommandWinnerText.TextTrimming" Value="None" />
                                                <Setter Target="CommandWinnerText.TextWrapping" Value="WrapWholeWords" />
                                                <Setter Target="CommandCandidateText.(Grid.Row)" Value="2" />
                                                <Setter Target="CommandCandidateText.(Grid.Column)" Value="0" />
                                                <Setter Target="CommandCandidateText.(Grid.ColumnSpan)" Value="3" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="WideCommandItem">
                                            <VisualState.StateTriggers>
                                                <AdaptiveTrigger MinWindowWidth="760" />
                                            </VisualState.StateTriggers>
                                            <VisualState.Setters>
                                                <Setter Target="CommandNameColumn.Width" Value="110" />
                                                <Setter Target="CommandWinnerColumn.Width" Value="*" />
                                                <Setter Target="CommandCandidateColumn.Width" Value="120" />
                                                <Setter Target="CommandWinnerRow.Height" Value="0" />
                                                <Setter Target="CommandCandidateRow.Height" Value="0" />
                                                <Setter Target="CommandNameText.(Grid.ColumnSpan)" Value="1" />
                                                <Setter Target="CommandWinnerText.(Grid.Row)" Value="0" />
                                                <Setter Target="CommandWinnerText.(Grid.Column)" Value="1" />
                                                <Setter Target="CommandWinnerText.(Grid.ColumnSpan)" Value="1" />
                                                <Setter Target="CommandWinnerText.TextTrimming" Value="CharacterEllipsis" />
                                                <Setter Target="CommandWinnerText.TextWrapping" Value="NoWrap" />
                                                <Setter Target="CommandCandidateText.(Grid.Row)" Value="0" />
                                                <Setter Target="CommandCandidateText.(Grid.Column)" Value="2" />
                                                <Setter Target="CommandCandidateText.(Grid.ColumnSpan)" Value="1" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <TextBlock
                                    x:Name="CommandNameText"
                                    FontWeight="SemiBold"
                                    Text="{Binding Command}"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    x:Name="CommandWinnerText"
                                    Grid.Column="1"
                                    IsTextSelectionEnabled="True"
                                    Text="{Binding Winner}"
                                    TextTrimming="CharacterEllipsis"
                                    ToolTipService.ToolTip="{Binding Winner}" />
                                <TextBlock
                                    x:Name="CommandCandidateText"
                                    Grid.Column="2"
                                    Text="{Binding CandidateText}"
                                    TextWrapping="Wrap" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </PivotItem>

            <PivotItem Header="语言工具与选择">
                <Grid RowSpacing="14">
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition Height="Auto" />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <ListView
                        x:Name="RuntimeList"
                        ItemContainerStyle="{StaticResource StretchDiagnosticListViewItemStyle}"
                        SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="12,8" ColumnSpacing="12" RowSpacing="3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition x:Name="RuntimeNameColumn" Width="160" />
                                        <ColumnDefinition x:Name="RuntimeVersionColumn" Width="130" />
                                        <ColumnDefinition x:Name="RuntimePathColumn" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition x:Name="RuntimeVersionRow" Height="0" />
                                        <RowDefinition x:Name="RuntimePathRow" Height="0" />
                                    </Grid.RowDefinitions>
                                    <VisualStateManager.VisualStateGroups>
                                        <VisualStateGroup>
                                            <VisualState x:Name="CompactRuntimeItem">
                                                <VisualState.StateTriggers>
                                                    <AdaptiveTrigger MinWindowWidth="0" />
                                                </VisualState.StateTriggers>
                                                <VisualState.Setters>
                                                    <Setter Target="RuntimeNameColumn.Width" Value="*" />
                                                    <Setter Target="RuntimeVersionColumn.Width" Value="0" />
                                                    <Setter Target="RuntimePathColumn.Width" Value="0" />
                                                    <Setter Target="RuntimeVersionRow.Height" Value="Auto" />
                                                    <Setter Target="RuntimePathRow.Height" Value="Auto" />
                                                    <Setter Target="RuntimeNameText.(Grid.ColumnSpan)" Value="3" />
                                                    <Setter Target="RuntimeVersionText.(Grid.Row)" Value="1" />
                                                    <Setter Target="RuntimeVersionText.(Grid.Column)" Value="0" />
                                                    <Setter Target="RuntimeVersionText.(Grid.ColumnSpan)" Value="3" />
                                                    <Setter Target="RuntimePathText.(Grid.Row)" Value="2" />
                                                    <Setter Target="RuntimePathText.(Grid.Column)" Value="0" />
                                                    <Setter Target="RuntimePathText.(Grid.ColumnSpan)" Value="3" />
                                                    <Setter Target="RuntimePathText.TextTrimming" Value="None" />
                                                    <Setter Target="RuntimePathText.TextWrapping" Value="WrapWholeWords" />
                                                </VisualState.Setters>
                                            </VisualState>
                                            <VisualState x:Name="WideRuntimeItem">
                                                <VisualState.StateTriggers>
                                                    <AdaptiveTrigger MinWindowWidth="760" />
                                                </VisualState.StateTriggers>
                                                <VisualState.Setters>
                                                    <Setter Target="RuntimeNameColumn.Width" Value="160" />
                                                    <Setter Target="RuntimeVersionColumn.Width" Value="130" />
                                                    <Setter Target="RuntimePathColumn.Width" Value="*" />
                                                    <Setter Target="RuntimeVersionRow.Height" Value="0" />
                                                    <Setter Target="RuntimePathRow.Height" Value="0" />
                                                    <Setter Target="RuntimeNameText.(Grid.ColumnSpan)" Value="1" />
                                                    <Setter Target="RuntimeVersionText.(Grid.Row)" Value="0" />
                                                    <Setter Target="RuntimeVersionText.(Grid.Column)" Value="1" />
                                                    <Setter Target="RuntimeVersionText.(Grid.ColumnSpan)" Value="1" />
                                                    <Setter Target="RuntimePathText.(Grid.Row)" Value="0" />
                                                    <Setter Target="RuntimePathText.(Grid.Column)" Value="2" />
                                                    <Setter Target="RuntimePathText.(Grid.ColumnSpan)" Value="1" />
                                                    <Setter Target="RuntimePathText.TextTrimming" Value="CharacterEllipsis" />
                                                    <Setter Target="RuntimePathText.TextWrapping" Value="NoWrap" />
                                                </VisualState.Setters>
                                            </VisualState>
                                        </VisualStateGroup>
                                    </VisualStateManager.VisualStateGroups>
                                    <TextBlock
                                        x:Name="RuntimeNameText"
                                        FontWeight="SemiBold"
                                        Text="{Binding Runtime}"
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        x:Name="RuntimeVersionText"
                                        Grid.Column="1"
                                        Text="{Binding Version}"
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        x:Name="RuntimePathText"
                                        Grid.Column="2"
                                        IsTextSelectionEnabled="True"
                                        Text="{Binding Path}"
                                        TextTrimming="CharacterEllipsis"
                                        ToolTipService.ToolTip="{Binding Path}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <TextBlock
                        Grid.Row="1"
                        Style="{StaticResource SubtitleTextBlockStyle}"
                        Text="全局选择解析" />
                    <ListView
                        x:Name="GlobalSelectionList"
                        Grid.Row="2"
                        ItemContainerStyle="{StaticResource StretchDiagnosticListViewItemStyle}"
                        SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="12,8" ColumnSpacing="12" RowSpacing="3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition x:Name="SelectionRuntimeColumn" Width="150" />
                                        <ColumnDefinition x:Name="SelectionSelectorColumn" Width="150" />
                                        <ColumnDefinition x:Name="SelectionResolutionColumn" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition x:Name="SelectionSelectorRow" Height="0" />
                                        <RowDefinition x:Name="SelectionResolutionRow" Height="0" />
                                    </Grid.RowDefinitions>
                                    <VisualStateManager.VisualStateGroups>
                                        <VisualStateGroup>
                                            <VisualState x:Name="CompactSelectionItem">
                                                <VisualState.StateTriggers>
                                                    <AdaptiveTrigger MinWindowWidth="0" />
                                                </VisualState.StateTriggers>
                                                <VisualState.Setters>
                                                    <Setter Target="SelectionRuntimeColumn.Width" Value="*" />
                                                    <Setter Target="SelectionSelectorColumn.Width" Value="0" />
                                                    <Setter Target="SelectionResolutionColumn.Width" Value="0" />
                                                    <Setter Target="SelectionSelectorRow.Height" Value="Auto" />
                                                    <Setter Target="SelectionResolutionRow.Height" Value="Auto" />
                                                    <Setter Target="SelectionRuntimeText.(Grid.ColumnSpan)" Value="3" />
                                                    <Setter Target="SelectionSelectorText.(Grid.Row)" Value="1" />
                                                    <Setter Target="SelectionSelectorText.(Grid.Column)" Value="0" />
                                                    <Setter Target="SelectionSelectorText.(Grid.ColumnSpan)" Value="3" />
                                                    <Setter Target="SelectionResolutionText.(Grid.Row)" Value="2" />
                                                    <Setter Target="SelectionResolutionText.(Grid.Column)" Value="0" />
                                                    <Setter Target="SelectionResolutionText.(Grid.ColumnSpan)" Value="3" />
                                                </VisualState.Setters>
                                            </VisualState>
                                            <VisualState x:Name="WideSelectionItem">
                                                <VisualState.StateTriggers>
                                                    <AdaptiveTrigger MinWindowWidth="760" />
                                                </VisualState.StateTriggers>
                                                <VisualState.Setters>
                                                    <Setter Target="SelectionRuntimeColumn.Width" Value="150" />
                                                    <Setter Target="SelectionSelectorColumn.Width" Value="150" />
                                                    <Setter Target="SelectionResolutionColumn.Width" Value="*" />
                                                    <Setter Target="SelectionSelectorRow.Height" Value="0" />
                                                    <Setter Target="SelectionResolutionRow.Height" Value="0" />
                                                    <Setter Target="SelectionRuntimeText.(Grid.ColumnSpan)" Value="1" />
                                                    <Setter Target="SelectionSelectorText.(Grid.Row)" Value="0" />
                                                    <Setter Target="SelectionSelectorText.(Grid.Column)" Value="1" />
                                                    <Setter Target="SelectionSelectorText.(Grid.ColumnSpan)" Value="1" />
                                                    <Setter Target="SelectionResolutionText.(Grid.Row)" Value="0" />
                                                    <Setter Target="SelectionResolutionText.(Grid.Column)" Value="2" />
                                                    <Setter Target="SelectionResolutionText.(Grid.ColumnSpan)" Value="1" />
                                                </VisualState.Setters>
                                            </VisualState>
                                        </VisualStateGroup>
                                    </VisualStateManager.VisualStateGroups>
                                    <TextBlock
                                        x:Name="SelectionRuntimeText"
                                        FontWeight="SemiBold"
                                        Text="{Binding Runtime}"
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        x:Name="SelectionSelectorText"
                                        Grid.Column="1"
                                        Text="{Binding Selector}"
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        x:Name="SelectionResolutionText"
                                        Grid.Column="2"
                                        Text="{Binding Resolution}"
                                        TextWrapping="Wrap" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </PivotItem>
        </Pivot>
    </Grid>
</Page>
